    }

    private async Task ConfirmarYAplicarLote()
    {
        if (!_loteAmortizacionesSeleccionadas.Any()) return;

        if (string.IsNullOrWhiteSpace(_origenNominaDetalle))
        {
            Snackbar.Add("Capture el nombre o concepto del lote de cobro.", Severity.Warning);
            return;
        }

        if (!_fechaPagoLote.HasValue)
        {
            Snackbar.Add("Capture la fecha de pago del lote.", Severity.Warning);
            return;
        }

        if (_loteAmortizacionesSeleccionadas.Any(x => x.MontoAplicar <= 0))
        {
            Snackbar.Add("Todos los importes seleccionados deben ser mayores a cero.", Severity.Warning);
            return;
        }

        var cntNomina = _loteAmortizacionesSeleccionadas.Count(x => !x.Amortizacion.EsPrestamoDirecto);
        var cntDirecto = _loteAmortizacionesSeleccionadas.Count(x => x.Amortizacion.EsPrestamoDirecto);
        var totalMonto = _loteAmortizacionesSeleccionadas.Sum(x => x.MontoAplicar);

        var detalle = new System.Text.StringBuilder();
        detalle.AppendLine($"Total de registros: {_loteAmortizacionesSeleccionadas.Count}");
        if (cntNomina > 0) detalle.AppendLine($"  • Nómina: {cntNomina} amortización(es)");
        if (cntDirecto > 0) detalle.AppendLine($"  • Directos: {cntDirecto} préstamo(s)");
        detalle.Append($"Monto total a aplicar: {totalMonto.ToString("C2")}");

        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmación de Cobranza Masiva",
            $"¿Está seguro de aplicar el pago para los siguientes registros?\n\n{detalle}",
            yesText: "Sí, Aplicar Pago", cancelText: "Cancelar");

        if (confirm != true) return;

        // Determinar método de pago: Nomina cuando hay amortizaciones, Efectivo si son solo directos
        var metodoPago = cntNomina > 0 ? "Nomina" : "Efectivo";

        _procesandoLote = true;
        try
        {
            var command = new AplicarPagoMasivoCommand
            {
                OrigenNomina = _origenNominaDetalle,
                MetodoPago = metodoPago,
                FechaCobro = _fechaPagoLote.Value,
                Detalles = _loteAmortizacionesSeleccionadas.Select(x => new DetallePagoMasivoDto
                {
                    PrestamoId = x.Amortizacion.PrestamoId,
                    NumeroPago = x.Amortizacion.EsPrestamoDirecto ? null : x.Amortizacion.NumeroPago,
                    AmortizacionId = x.Amortizacion.EsPrestamoDirecto ? null : (x.Amortizacion.AmortizacionId > 0 ? x.Amortizacion.AmortizacionId : (int?)null),
                    EsPrestamoDirecto = x.Amortizacion.EsPrestamoDirecto,
                    PrestamoDirectoId = x.Amortizacion.EsPrestamoDirecto ? x.Amortizacion.PrestamoDirectoId : null,
                    MontoAplicado = x.MontoAplicar
                }).ToList()
            };

            var response = await CobrosApi.AplicarPagoMasivoAsync(command);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BulkPaymentResultDto>();
                if (result != null)
                {
                    _ultimoLoteIdGenerado = result.LoteId;
                    _loteIdCancelar = result.LoteId ?? _loteIdCancelar;

                    if (result.Fallidos == 0)
                    {
                        Snackbar.Add($"¡Lote de cobros aplicado con éxito! LoteId: {result.LoteId}. Procesados: {result.Exitosos}", Severity.Success);
                    }
                    else
                    {
                        var errores = result.DetallesErrores?.Where(x => !string.IsNullOrWhiteSpace(x)).ToList() ?? new List<string>();
                        var errorMsg = errores.Count > 0
                            ? string.Join("\n", errores)
                            : "No se recibieron detalles de validación desde el servidor.";

                        Snackbar.Add($"El lote no se aplicó debido a {result.Fallidos} errores de validación.", Severity.Error);
                        await DialogService.ShowMessageBoxAsync("Errores en Lote", errorMsg, yesText: "Entendido");
                    }
                }
                
                await CargarLoteCobro(); // Refrescar la grilla
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al aplicar lote masivo: {errorText}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al procesar el lote: {ex.Message}", Severity.Error);
        }
        finally
        {
            _procesandoLote = false;
        }
    }

    private async Task ConfirmarYCancelarLotePorId()
    {
        if (string.IsNullOrWhiteSpace(_loteIdCancelar))
        {
            Snackbar.Add("Capture el LoteId que desea cancelar.", Severity.Warning);
            return;
        }

        var loteId = _loteIdCancelar.Trim();

        List<CobroAplicadoDto> cobrosLote;
        try
        {
            cobrosLote = await CobrosApi.GetCobrosAplicadosPorLoteAsync(loteId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No fue posible consultar el detalle del lote: {ex.Message}", Severity.Error);
            return;
        }

        if (!cobrosLote.Any())
        {
            Snackbar.Add($"No se encontraron pagos o amortizaciones para el lote {loteId}.", Severity.Warning);
            return;
        }

        var totalMonto = cobrosLote.Sum(x => x.MontoTotal);
        var resumen = new System.Text.StringBuilder();
        resumen.AppendLine($"Lote: {loteId}");
        resumen.AppendLine($"Registros: {cobrosLote.Count}");
        resumen.AppendLine($"Monto total: {totalMonto.ToString("C2", CultureInfo.CurrentCulture)}");
        resumen.AppendLine();
        resumen.AppendLine("Pagos/Amortizaciones a cancelar:");

        foreach (var item in cobrosLote.OrderBy(x => x.FechaCobro).ThenBy(x => x.Concepto).Take(30))
        {
            resumen.AppendLine($"• {item.FechaCobro:dd/MM/yyyy} | Préstamo {item.PrestamoId} | {item.Concepto} | {item.MontoTotal.ToString("C2", CultureInfo.CurrentCulture)}");
        }

        if (cobrosLote.Count > 30)
        {
            resumen.AppendLine($"... y {cobrosLote.Count - 30} registro(s) más.");
        }

        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmación de Cancelación de Lote",
            $"{resumen}\n\n¿Desea continuar con la cancelación?",
            yesText: "Sí, Cancelar Lote",
            cancelText: "No");

        if (confirm != true)
            return;

        _cancelandoLote = true;
        try
        {
            var response = await CobrosApi.CancelarCobroMasivoPorLoteAsync(loteId);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BulkCancelResultDto>();
                if (result is not null)
                {
                    if (result.Fallidos == 0)
                    {
                        Snackbar.Add($"Lote {result.LoteId} cancelado correctamente. Cobros revertidos: {result.Cancelados}.", Severity.Success);
                        await CargarLoteCobro();
                    }
                    else
                    {
                        var errores = result.DetallesErrores?.Where(x => !string.IsNullOrWhiteSpace(x)).ToList() ?? new List<string>();
                        var errorMsg = errores.Count > 0
                            ? string.Join("\n", errores)
                            : "No se recibieron detalles de validación desde el servidor.";

                        Snackbar.Add($"No se canceló el lote {result.LoteId}. Errores: {result.Fallidos}.", Severity.Error);
                        await DialogService.ShowMessageBoxAsync("Errores en Cancelación de Lote", errorMsg, yesText: "Entendido");
                    }
                }
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al cancelar lote: {errorText}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cancelar lote: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cancelandoLote = false;
        }
    }
