    // ---- SECCIÓN PAGO MASIVO ----
    private async Task CargarLoteCobro()
    {
        _loteAmortizaciones.Clear();
        _loteAmortizacionesSeleccionadas.Clear();
        
        try
        {
            var pendientes = await CobrosApi.GetPendientesAsync(_loteEmpresaId, _loteTipoPagoId, _loteFechaVencimiento);
            _loteAmortizaciones = pendientes.Select(p => new LoteCobroItem
            {
                Amortizacion = p,
                MontoAplicar = p.ImportePago,
                Diferencia = 0,
                Selected = false
            }).ToList();

            Snackbar.Add($"Se cargaron {_loteAmortizacionesPorTipo.Count()} registros para el filtro seleccionado.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar amortizaciones: {ex.Message}", Severity.Error);
        }
    }

    private IEnumerable<LoteCobroItem> _loteAmortizacionesPorTipo => _loteAmortizaciones.Where(CumpleFiltroTipoLote);

    private bool CumpleFiltroTipoLote(LoteCobroItem item)
    {
        ArgumentNullException.ThrowIfNull(item);

        return _loteTipoFiltro switch
        {
            "Nomina" => !item.Amortizacion.EsPrestamoDirecto,
            "Directo" => item.Amortizacion.EsPrestamoDirecto,
            _ => true
        };
    }

    private Func<LoteCobroItem, bool> _quickFilterLote => x =>
    {
        if (string.IsNullOrWhiteSpace(_loteSearchString)) return true;

        if (!string.IsNullOrWhiteSpace(x.Amortizacion.Folio) && x.Amortizacion.Folio.Contains(_loteSearchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Amortizacion.EmpleadoNombre.Contains(_loteSearchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Amortizacion.EmpresaNombre.Contains(_loteSearchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Amortizacion.EsPrestamoDirecto && !string.IsNullOrWhiteSpace(x.Amortizacion.DescripcionPrestamoDirecto) &&
            x.Amortizacion.DescripcionPrestamoDirecto.Contains(_loteSearchString, StringComparison.OrdinalIgnoreCase)) return true;
        if ($"{x.Amortizacion.NumeroPago}".Contains(_loteSearchString, StringComparison.OrdinalIgnoreCase)) return true;

        return false;
    };

    private int _totalFiltrados => _loteAmortizacionesPorTipo.Count(_quickFilterLote);
    private int _filtradosSeleccionados => _loteAmortizacionesPorTipo.Count(x => x.Selected && _quickFilterLote(x));
    private decimal _montoFiltradoProgramado => _loteAmortizacionesPorTipo.Where(_quickFilterLote).Sum(x => x.Amortizacion.ImportePago);
    private decimal _montoFiltradoSeleccionado => _loteAmortizacionesPorTipo.Where(x => x.Selected && _quickFilterLote(x)).Sum(x => x.MontoAplicar);

    private void SetLoteItemSelection(LoteCobroItem item, bool selected)
    {
        item.Selected = selected;
        if (selected)
        {
            _loteAmortizacionesSeleccionadas.Add(item);
        }
        else
        {
            _loteAmortizacionesSeleccionadas.Remove(item);
        }
    }

    private void SincronizarSeleccionLoteVisible()
    {
        var visibles = _loteAmortizacionesPorTipo.ToHashSet();
        var ocultosSeleccionados = _loteAmortizacionesSeleccionadas.Where(x => !visibles.Contains(x)).ToList();

        foreach (var item in ocultosSeleccionados)
        {
            item.Selected = false;
            _loteAmortizacionesSeleccionadas.Remove(item);
        }
    }

