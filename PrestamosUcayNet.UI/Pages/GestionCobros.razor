    private void OnMontoRecibidoChanged()
    {
        RecalcularDistribucion();
    }

    private void RecalcularDistribucion()
    {
        if (_amortizacionSeleccionada == null) return;

        decimal totalRequerido = _amortizacionSeleccionada.ImportePago;
        decimal interesRequerido = _amortizacionSeleccionada.ImporteInteres;
        decimal capitalRequerido = _amortizacionSeleccionada.ImporteCapital;

        decimal remanente = _montoRecibido;

        // 1. Interés primero
        if (remanente >= interesRequerido)
        {
            _distInteres = interesRequerido;
            remanente -= interesRequerido;
        }
        else
        {
            _distInteres = remanente;
            remanente = 0;
        }

        // 2. Capital programado
        if (remanente >= capitalRequerido)
        {
            _distCapital = capitalRequerido;
            remanente -= capitalRequerido;
        }
        else
        {
            _distCapital = remanente;
            remanente = 0;
        }

        // 3. Remanente a pago extra a capital
        _distExtra = remanente;

        // 4. Pendiente de la cuota
        decimal totalAplicadoACuotaProgramada = _distInteres + _distCapital;
        _distPendiente = Math.Max(0, totalRequerido - totalAplicadoACuotaProgramada);
    }

    private async Task AplicarCobroIndividual()
    {
        if (_amortizacionSeleccionada == null || _prestamoDetalle == null) return;

        if (_montoRecibido <= 0)
        {
            Snackbar.Add("El monto recibido debe ser mayor a cero.", Severity.Warning);
            return;
        }

        _guardandoCobro = true;
        try
        {
            var command = new AplicarPagoIndividualCommand
            {
                PrestamoId = _prestamoDetalle.Id,
                NumeroPago = _amortizacionSeleccionada.NumeroPago,
                MontoRecibido = _montoRecibido,
                MetodoPago = _metodoPago,
                Referencia = _referenciaPago,
                FechaPago = _fechaPagoIndividual ?? DateTime.Today
            };

            var response = await CobrosApi.AplicarPagoIndividualAsync(command);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("¡Cobro aplicado exitosamente!", Severity.Success);
                
                // Recargar el préstamo y sus amortizaciones
                if (_prestamoSeleccionado != null)
                {
                    await OnPrestamoSelected(_prestamoSeleccionado);
                }
                
                _amortizacionSeleccionada = null;
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al aplicar pago: {errorText}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _guardandoCobro = false;
        }
    }

