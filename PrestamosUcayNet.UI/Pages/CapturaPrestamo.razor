    // ── Simulación ──

    /// <summary>
    /// Verifica si la fecha de entrega supera el cierre de caja del año actual;
    /// si es así, carga los parámetros del año siguiente y reporta error si no existen.
    /// </summary>
    private async Task VerificarParametrosProxAnioAsync()
    {
        if (!EsCajaDeAhorro) return;

        DateTime entrega = _fechaEntrega ?? DateTime.Today;
        DateTime? cierreActual = _parametros.CierreCajaAnual;

        if (!cierreActual.HasValue || entrega <= cierreActual.Value)
        {
            _parametrosProximoAnio = null;
            return;
        }

        // Necesitamos el siguiente año
        int anioSiguiente = entrega.Year + (entrega.Month >= 11 ? 1 : 0);
        if (_parametrosProximoAnio?.Anio == anioSiguiente) return; // ya cargado

        try
        {
            var p = await ParametrosApi.GetParametrosAsync(anioSiguiente);
            if (p.CierreCajaAnual is null)
            {
                Snackbar.Add(
                    $"El cierre anual de caja de ahorro del año {anioSiguiente} no ha sido capturado. " +
                    "Configúrelo en Parámetros Generales antes de continuar.",
                    Severity.Error);
                _parametrosProximoAnio = null;
            }
            else
            {
                _parametrosProximoAnio = p;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar parámetros de {anioSiguiente}: {ex.Message}", Severity.Error);
            _parametrosProximoAnio = null;
        }
    }

    /// <summary>
    /// Cuando el usuario cambia la Fecha Final en modo nómina (no Caja de Ahorro),
    /// recalcula el plazo en meses y lanza la simulación.
    /// </summary>
    private async Task OnFechaFinalNominaChanged(DateTime? fecha)
    {
        if (_actualizandoDesdeSimulacion) return;
        _preview = null;
        _fechaFinalDescuento = fecha;
        RecalcularFechas();
        StateHasChanged();
        await SimularAmortizacionCore(recalcularFechas: false);
    }

    private void OnFechaVencimientoManualCajaChanged(DateTime? fecha)
    {
        _preview = null;
        if (!EsCajaDeAhorro || fecha is null)
        {
            _fechaFinalDescuento = fecha;
            RecalcularFechas();
            return;
        }

        DateTime? cierre = FechaCierreCajaEfectiva;

        // Primero limitar al cierre de caja
        DateTime fechaEfectiva = cierre.HasValue && fecha.Value > cierre.Value
            ? cierre.Value
            : fecha.Value;

        // Ajustar a la fecha de nómina más cercana anterior o igual
        DateTime? fechaNomina = AjustarAFechaNomina(fechaEfectiva);

        if (fechaNomina is null)
        {
            // Sin calendario de nómina aplicable, usar la fecha efectiva tal cual
            _fechaFinalDescuento = fechaEfectiva;
            RecalcularFechas();
            return;
        }

        if (fechaNomina.Value != fechaEfectiva)
        {
            Snackbar.Add(
                $"La fecha fue ajustada al corte de nómina más próximo: {fechaNomina.Value:dd/MM/yyyy}.",
                Severity.Info);
        }

        if (cierre.HasValue && fechaNomina.Value > cierre.Value)
        {
            Snackbar.Add(
                $"La fecha de vencimiento no puede exceder el cierre de caja ({cierre.Value:dd/MM/yyyy}).",
                Severity.Warning);
            _fechaFinalDescuento = cierre;
        }
        else
        {
            _fechaFinalDescuento = fechaNomina;
        }

        RecalcularFechas();
    }

    /// <summary>
    /// Devuelve la fecha de nómina más cercana que sea ≤ <paramref name="fecha"/>.
    /// Usa el calendario del tipo de pago seleccionado (semanal/catorcenal).
    /// Retorna <c>null</c> cuando no aplica calendario de nómina (mensual, quincenal, etc.).
    /// </summary>
    private DateTime? AjustarAFechaNomina(DateTime fecha)
    {
        var tipoPago = _tiposPago.FirstOrDefault(tp => tp.TipoPagoId == _model.TipoPagoId);
        if (tipoPago is null) return null;

        DateTime? inicioPeriodo = tipoPago.IntervaloDiario switch
        {
            7  => _parametros.InicioPeriodoSemanal,
            14 => _parametros.InicioPeriodoCatorcenal,
            _  => null
        };

        if (inicioPeriodo is null) return null;

        int intervalo = tipoPago.IntervaloDiario;

        // Avanzar desde el inicio hasta superar la fecha objetivo,
        // luego retroceder un paso para obtener la última fecha ≤ fecha.
        DateTime cursor = inicioPeriodo.Value;
        while (cursor <= fecha)
            cursor = cursor.AddDays(intervalo);

        return cursor.AddDays(-intervalo);
    }

    /// <summary>
    /// Devuelve <c>true</c> si <paramref name="fecha"/> coincide exactamente con un corte
    /// del calendario de nómina del tipo de pago seleccionado.
    /// </summary>
    private bool EsFechaDeNomina(DateTime fecha)
    {
        var fechaCorte = AjustarAFechaNomina(fecha);
        return fechaCorte.HasValue && fechaCorte.Value.Date == fecha.Date;
    }

    private async Task OnFondeadoraChanged(int fondeadoraId)
    {
        _model.FondeadoraId = fondeadoraId;

        // Si es Caja de Ahorro, establecer automáticamente el tipo de préstamo a Corto Plazo
        // y aplicar las tasas fijas desde parámetros generales
        if (EsCajaDeAhorro)
        {
            var cortoPlazoTipo = _tiposPrestamo.FirstOrDefault(tp => tp.Clasificacion == PrestamosUcayNet.Domain.Enums.ClasificacionTipoPrestamo.CortoPlazo);
            if (cortoPlazoTipo != null)
                _model.TipoPrestamoId = cortoPlazoTipo.TipoPrestamoId;

            if (_parametros.TasaFijaCaja.HasValue)
                _tasaMensual = _parametros.TasaFijaCaja.Value;

            await VerificarParametrosProxAnioAsync();
            RecalcularFechas();
        }
        else
        {
            _parametrosProximoAnio = null;
            _nominaActiva = true; // Nómina siempre requerida cuando la fondeadora no es Caja de Ahorro
            if (_parametros.TasaFijaEmpresa.HasValue)
                _tasaMensual = _parametros.TasaFijaEmpresa.Value;
        }

        // Reestablecer la tasa de los préstamos directos ya capturados
        foreach (var d in _prestamosDirectos)
            d.TasaMensual = TasaDirectoEfectiva;

        StateHasChanged();
    }

    private async Task OnFrecuenciaPagoChanged(int tipoPagoId)
    {
        _model.TipoPagoId = tipoPagoId;
        await SimularAmortizacion();
    }

    private async Task OnFechaEntregaChanged(DateTime? newDate)
    {
        if (newDate.HasValue)
        {
            if (_fechaSolicitud.HasValue && newDate.Value.Date < _fechaSolicitud.Value.Date)
            {
                Snackbar.Add($"La fecha de entrega ({newDate.Value:dd/MM/yyyy}) no puede ser menor a la fecha de la solicitud ({_fechaSolicitud.Value:dd/MM/yyyy}).", Severity.Warning);
                return;
            }

            try
            {
                var paramsAnio = await ParametrosApi.GetParametrosAsync(newDate.Value.Year);
                if (paramsAnio == null || paramsAnio.Anio != newDate.Value.Year)
                {
                    Snackbar.Add($"No existen parámetros generales configurados para el año {newDate.Value.Year}. Se requiere para generar el calendario de nómina.", Severity.Error);
                    return;
                }
                _parametros = paramsAnio;
            }
            catch (Exception)
            {
                Snackbar.Add($"No existen parámetros generales configurados para el año {newDate.Value.Year}. Se requiere para generar el calendario de nómina.", Severity.Error);
                return;
            }
        }

        _fechaEntrega = newDate;
        _model.FechaEntrega = newDate ?? DateTime.Today;
        _preview = null;

        if (EsCajaDeAhorro)
            await VerificarParametrosProxAnioAsync();

        RecalcularFechas();

        // Recalcular días de plazo de todos los préstamos directos existentes
        // usando la nueva fecha de entrega como base.
        DateTime fechaBase = _fechaEntrega ?? DateTime.Today;
        foreach (var pd in _prestamosDirectos)
            pd.DiazPlazo = Math.Max(1, (pd.FechaPago - fechaBase).Days);
        await SimularAmortizacion();
    }

    private void RecalcularFechas()
    {
        if (!_fechaEntrega.HasValue) return;

        if (EsCajaDeAhorro)
        {
            // Si aún no hay fecha final, inicializar con el cierre de caja
            if (!_fechaFinalDescuento.HasValue)
                _fechaFinalDescuento = FechaCierreCajaEfectiva ?? _fechaEntrega.Value.AddMonths(1);
        }
        else
        {
            // Si no hay fecha final capturada, inicializar a un mes
            if (!_fechaFinalDescuento.HasValue)
                _fechaFinalDescuento = _fechaEntrega.Value.AddMonths(1);
        }

        // Plazo siempre derivado de la fecha final de descuento
        if (_fechaFinalDescuento.HasValue && _fechaFinalDescuento.Value > _fechaEntrega.Value)
        {
            int meses = (int)Math.Ceiling(
                (_fechaFinalDescuento.Value - _fechaEntrega.Value).TotalDays / 30.4375);
            _model.PlazoMeses = Math.Max(1, meses);
        }
    }

    private async Task SimularAmortizacion()
    {
        await SimularAmortizacionCore(recalcularFechas: true);
    }

    private async Task SimularAmortizacionCore(bool recalcularFechas)
    {
        if (!_nominaActiva) return;
        if (!PuedeSimular) return;

        _simulando = true;
        if (recalcularFechas)
            RecalcularFechas();

        try
        {
            _model.TasaInteresMensual = _tasaMensual;

            var tipoPagoSeleccionado = _tiposPago.FirstOrDefault(tp => tp.TipoPagoId == _model.TipoPagoId);

            DateTime? fechaInicioPeriodo = tipoPagoSeleccionado?.IntervaloDiario switch
            {
                7  => _parametros.InicioPeriodoSemanal,
                14 => _parametros.InicioPeriodoCatorcenal,
                _  => null
            };

            // FechaCierreCaja solo aplica para Caja de Ahorro.
            // Para nómina normal se determina si la fecha final coincide con un corte;
            // en ese caso se pasa como cap en una segunda llamada (ver abajo).
            DateTime? cierreCaja = EsCajaDeAhorro
                ? _fechaFinalDescuento ?? FechaCierreCajaEfectiva
                : null;

            var dto = new SimularAmortizacionDto
            {
                MontoAprobado      = _model.MontoAprobado,
                PlazoMeses         = _model.PlazoMeses,
                TasaInteresAnual   = _tasaMensual * 12m,
                FechaEntrega       = _fechaEntrega ?? DateTime.Today,
                IntervaloDiario    = tipoPagoSeleccionado?.IntervaloDiario ?? 30,
                FrecuenciaAnual    = tipoPagoSeleccionado?.FrecuenciaAnual ?? 12,
                FechaInicioPeriodo = fechaInicioPeriodo,
                FechaCierreCaja    = cierreCaja,
                PrestamosDirectos  = _prestamosDirectos
            };

            _preview = await PrestamosApi.SimularAmortizacionAsync(dto);

            if (_preview is not null)
            {
                DateTime ultimaFechaTabla = _preview.FechaUltimoPago;

                _actualizandoDesdeSimulacion = true;
                try
                {
                    if (!EsCajaDeAhorro && _fechaFinalDescuento.HasValue)
                    {
                        bool fechaEsCorteNomina = EsFechaDeNomina(_fechaFinalDescuento.Value);

                        if (fechaEsCorteNomina
                            && _fechaFinalDescuento.Value.Date != ultimaFechaTabla.Date)
                        {
                            // La fecha final coincide con un corte de nómina pero la tabla
                            // generó una cuota adicional más allá de ella.
                            // Re-simular pasando la fecha final como cap para que la última
                            // amortización quede exactamente en ese corte.
                            dto.FechaCierreCaja = _fechaFinalDescuento.Value;
                            _preview = await PrestamosApi.SimularAmortizacionAsync(dto);
                            ultimaFechaTabla = _preview?.FechaUltimoPago ?? ultimaFechaTabla;
                        }
                        else if (!fechaEsCorteNomina
                                 && _fechaFinalDescuento.Value.Date != ultimaFechaTabla.Date)
                        {
                            // No es un corte exacto: ajustar la fecha final al resultado real.
                            Snackbar.Add(
                                $"La fecha de vencimiento fue ajustada a la última amortización: {ultimaFechaTabla:dd/MM/yyyy}.",
                                Severity.Info);
                            _fechaFinalDescuento = ultimaFechaTabla;
                        }
                    }
                    else if (EsCajaDeAhorro
                             && _fechaFinalDescuento.HasValue
                             && _fechaFinalDescuento.Value.Date != ultimaFechaTabla.Date)
                    {
                        // Caja de Ahorro: sincronizar con el resultado de la tabla.
                        _fechaFinalDescuento = ultimaFechaTabla;
                    }

                    // Plazo siempre derivado de la última amortización efectiva.
                    if (_fechaEntrega.HasValue && _preview is not null)
                    {
                        int meses = (int)Math.Ceiling(
                            (_preview.FechaUltimoPago - _fechaEntrega.Value).TotalDays / 30.4375);
                        _model.PlazoMeses = Math.Max(1, meses);
                    }
                }
                finally
                {
                    _actualizandoDesdeSimulacion = false;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al simular amortización: {ex.Message}", Severity.Error);
        }
        finally
        {
            _simulando = false;
        }
    }

    // ── Guardar ──

    private async Task GuardarPrestamo()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        if (_model.FondeadoraId <= 0)
        {
            Snackbar.Add("Debe seleccionar una fuente de fondeo.", Severity.Warning);
            return;
        }

        if (_model.EmpleadoId <= 0)
        {
            Snackbar.Add("Debe seleccionar un empleado.", Severity.Warning);
            return;
        }

        // Solo validar tipo de préstamo si no es Caja de Ahorro (ya se establece automáticamente)
        if (!EsCajaDeAhorro && _model.TipoPrestamoId <= 0)
        {
            Snackbar.Add("Debe seleccionar un tipo de préstamo.", Severity.Warning);
            return;
        }

        // Validar que la solicitud tenga al menos una modalidad con datos
        if (EsCajaDeAhorro && !_nominaActiva && _prestamosDirectos.Count == 0)
        {
            Snackbar.Add("Debe incluir al menos un Préstamo Directo o activar el Préstamo Nómina.", Severity.Warning);
            return;
        }

        if (_nominaActiva)
        {
            if (_model.MontoAprobado <= 0)
            {
                Snackbar.Add("El monto solicitado debe ser mayor a cero.", Severity.Warning);
                return;
            }

            if (_model.PlazoMeses <= 0)
            {
                Snackbar.Add("El plazo debe ser mayor a cero.", Severity.Warning);
                return;
            }

            if (!EsCajaDeAhorro)
            {
                var errorPlazo = ValidarPlazo(_model.PlazoMeses);
                if (errorPlazo is not null)
                {
                    Snackbar.Add(errorPlazo, Severity.Warning);
                    return;
                }
            }

            if (_tasaMensual <= 0)
            {
                Snackbar.Add("La tasa de interés debe ser mayor a cero.", Severity.Warning);
                return;
            }

            if (_preview is null)
            {
                Snackbar.Add("Debe calcular la amortización antes de guardar.", Severity.Warning);
                return;
            }
        }

        // Validaciones específicas de Caja de Ahorro
        if (EsCajaDeAhorro)
        {
            DateTime? cierre = FechaCierreCajaEfectiva;
            if (cierre is null)
            {
                Snackbar.Add(
                    "No se encontró la fecha de cierre de caja de ahorro vigente. " +
                    "Verifique que los Parámetros Generales del año correspondiente estén capturados.",
                    Severity.Error);
                return;
            }

            if (_fechaFinalDescuento.HasValue &&
                _fechaFinalDescuento.Value > cierre.Value)
            {
                Snackbar.Add(
                    $"La fecha de vencimiento manual ({_fechaFinalDescuento.Value:dd/MM/yyyy}) " +
                    $"excede el cierre anual de caja ({cierre.Value:dd/MM/yyyy}).",
                    Severity.Error);
                return;
            }

            if (_fechaFinalDescuento.HasValue && _fechaFinalDescuento.Value > cierre.Value)
            {
                Snackbar.Add(
                    $"La fecha final de descuento ({_fechaFinalDescuento.Value:dd/MM/yyyy}) " +
                    $"excede el cierre anual de caja ({cierre.Value:dd/MM/yyyy}).",
                    Severity.Error);
                return;
            }
        }

        _confirmarGuardadoVisible = true;
    }

    private async Task EjecutarGuardar()
    {
        _saving = true;
        try
        {
            _model.FechaSolicitud = (_fechaSolicitud ?? DateTime.Today).Date;
            _model.FechaEntrega = (_fechaEntrega ?? DateTime.Today).Date;

            // Mapear la tabla de amortización (solo si el Préstamo Nómina está activo)
            _model.Amortizaciones = _nominaActiva
                ? _preview?.TablaAmortizacion.Select(a => new AmortizacionDto
                {
                    NumeroPago = a.NumeroPago,
                    FechaPago = a.FechaPago,
                    ImportePago = a.ImportePago,
                    ImporteInteres = a.ImporteInteres,
                    ImporteCapital = a.ImporteCapital,
                    PagoExtra = 0,
                    SaldoFinal = a.SaldoFinal
                }).ToList() ?? []
                : [];

            if (!_nominaActiva)
            {
                _model.MontoAprobado = 0;
                _model.TasaInteresMensual = 0;

                // Derivar el plazo desde la fecha de pago mayor de los préstamos directos
                DateTime? fechaMaxDirecto = _prestamosDirectos.Count > 0
                    ? _prestamosDirectos.Max(d => d.FechaPago)
                    : null;

                _model.PlazoMeses = fechaMaxDirecto.HasValue && _fechaEntrega.HasValue
                    ? Math.Max(1, (int)Math.Ceiling((fechaMaxDirecto.Value - _fechaEntrega.Value).TotalDays / 30.4375))
                    : 1;
            }

            // Mapear préstamos directos
            _model.PrestamosDirectos = _prestamosDirectos;

            bool result;
            if (_prestamoId > 0)
            {
                // Edición: actualizar la solicitud existente, nunca crear una nueva.
                result = await PrestamosApi.ActualizarSolicitudAsync(_prestamoId, _model);
                if (result)
                {
                    Snackbar.Add("¡Solicitud actualizada exitosamente!", Severity.Success);
                    _confirmarGuardadoVisible = false;
                    Navigation.NavigateTo("/gestion-solicitudes");
                }
                else
                {
                    Snackbar.Add("Error al actualizar la solicitud.", Severity.Error);
                }
            }
            else
            {
                // Alta: crear una solicitud nueva.
                result = await PrestamosApi.CrearAsync(_model);
                if (result)
                {
                    Snackbar.Add("¡Solicitud registrada exitosamente! Será revisada para aprobación.", Severity.Success);
                    _confirmarGuardadoVisible = false;
                    Navigation.NavigateTo("/gestion-solicitudes");
                }
                else
                {
                    Snackbar.Add("Error al registrar la solicitud.", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Limpiar ──

    private void LimpiarFormulario()
    {
        _model = new PrestamoCreateDto
        {
            DestinoCredito = string.Empty,
            FechaEntrega = DateTime.Today,
            PlazoMeses = 1,
            MontoAprobado = 0
        };
        _tasaMensual = 5;
        _fechaSolicitud = DateTime.Today;
        _fechaEntrega = DateTime.Today;
        _fechaFinalDescuento = null;
        _empleadoSeleccionado = null;
        _empleadoIdBuscar = 0;
        _preview = null;
        _prestamoId = 0;
        _prestamosDirectos = [];
        _nominaActiva = true;

        if (_tiposPago.Count > 0)
            _model.TipoPagoId = _tiposPago[0].TipoPagoId;

        StateHasChanged();
    }

    /// <summary>Limpia los datos del Préstamo Nómina. Solo disponible cuando la fondeadora es Caja de Ahorro.</summary>
    private void LimpiarPrestamoNomina()
    {
        _model.MontoAprobado = 0;
        _model.PlazoMeses = 1;
        _fechaFinalDescuento = null;
        _preview = null;
        _nominaActiva = false;
        StateHasChanged();
    }

    // ── Pagos Adicionales ──

    private void AgregarPrestamoDirecto()
    {
        var fechaBase = _fechaEntrega ?? DateTime.Today;
        // Para Caja de Ahorro: la fecha de pago por defecto es el último día del mes del cierre.
        // Para otras fondeadoras: fecha de entrega + 30 días.
        var fechaPago = EsCajaDeAhorro
            ? (FechaCierreDirectoEfectiva ?? fechaBase.AddDays(30))
            : fechaBase.AddDays(30);
        var tasaDirecto = TasaDirectoEfectiva;
        _prestamosDirectos.Add(new PrestamoDirectoCreateDto
        {
            Descripcion     = string.Empty,
            MontoSolicitado = 0,
            TasaMensual     = tasaDirecto,
            FechaPago       = fechaPago,
            DiazPlazo       = Math.Max(1, (fechaPago - fechaBase).Days)
        });
    }

    private void EliminarPrestamoDirecto(int index)
    {
        if (index >= 0 && index < _prestamosDirectos.Count)
            _prestamosDirectos.RemoveAt(index);
    }

    private void OnFechaPagoDirectoChanged(PrestamoDirectoCreateDto prestamo, DateTime? fecha)
    {
        if (fecha is null) return;

        DateTime fechaEfectiva = fecha.Value;
        DateTime fechaMinima = _fechaEntrega ?? DateTime.Today;

        if (fechaEfectiva < fechaMinima)
        {
            Snackbar.Add(
                $"La fecha de pago no puede ser menor a la fecha de entrega ({fechaMinima:dd/MM/yyyy}).",
                Severity.Warning);
            fechaEfectiva = fechaMinima;
        }

        // Para Caja de Ahorro los directos pueden llegar hasta el último día del mes del cierre.
        if (EsCajaDeAhorro && FechaCierreDirectoEfectiva.HasValue && fechaEfectiva > FechaCierreDirectoEfectiva.Value)
        {
            Snackbar.Add(
                $"La fecha de pago no puede exceder el último día del mes del cierre de caja ({FechaCierreDirectoEfectiva.Value:dd/MM/yyyy}).",
                Severity.Warning);
            fechaEfectiva = FechaCierreDirectoEfectiva.Value;
        }

        prestamo.FechaPago = fechaEfectiva;
        prestamo.DiazPlazo = Math.Max(1, (fechaEfectiva - fechaMinima).Days);
    }

    // ── Intercepción de Navegación ──

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (_saving) return ValueTask.CompletedTask;

        if (FormularioModificado)
        {
            _pendingNavigationUrl = context.TargetLocation;
            context.PreventNavigation();
            _confirmarSalidaVisible = true;
            StateHasChanged();
        }

        return ValueTask.CompletedTask;
    }

    private void ConfirmarSalida()
    {
        _confirmarSalidaVisible = false;
        _locationChangingRegistration?.Dispose();
        _locationChangingRegistration = null;
        Navigation.NavigateTo(_pendingNavigationUrl);
    }

    private void CancelarSalida()
    {
        _confirmarSalidaVisible = false;
        _pendingNavigationUrl = string.Empty;
    }

    public void Dispose()
    {
        _locationChangingRegistration?.Dispose();
    }
}
