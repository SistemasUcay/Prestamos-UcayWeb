@page "/captura-prestamo"
@page "/captura-prestamo/{PrestamoEditId:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador,Gerente,Contador")]
@using PrestamosUcayNet.Application.DTOs
@implements IDisposable
@inject PrestamosApiService PrestamosApi
@inject EmpleadosApiService EmpleadosApi
@inject EmpresasApiService EmpresasApi
@inject CatalogosApiService CatalogosApi
@inject ParametrosApiService ParametrosApi
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Solicitud de Préstamos — Préstamos UcayNet</PageTitle>

@* ── Barra de Título ── *@
<MudPaper Elevation="1" Class="pa-0.5 mb-2" Style="background: var(--mud-palette-primary); color: white; border-radius: 8px 8px 0 0;">
    <div class="d-flex align-center justify-space-between">
        <MudText Typo="Typo.h6" Style="color: white;">
            <MudIcon Icon="@Icons.Material.Filled.RequestPage" Class="mr-1" Style="vertical-align: auto" />
            Solicitud de Préstamos 
        </MudText>
        <div class="d-flex gap-1">
            <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Inherit" Title="Guardar"
                           OnClick="GuardarPrestamo"  Disabled="@(_saving || !_formValid)"/>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Inherit" Title="Limpiar"
                           OnClick="LimpiarFormulario" />
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Title="Regresar a Solicitudes"
                           OnClick="@(() => Navigation.NavigateTo("/gestion-solicitudes"))" />
        </div>
    </div>
</MudPaper>

<MudForm @ref="_form" @bind-IsValid="_formValid">
    @* ── ENCABEZADO ── *@
    <MudPaper Elevation="1" Class="pa-4 mb-2" Style="border-radius: 0;">
        <MudGrid Spacing="1">
            @* Fila 1: Número Solicitud, Fuente de Fondeo, Fecha *@
            <MudItem xs="12" md="2">
                <MudTextField T="string" Label="Número Solicitud" Value="@(_prestamoId > 0 ? _prestamoId.ToString() : "Nuevo")"
                              ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Tag" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="int" Label="Fuente de Fondeo" Value="_model.FondeadoraId" ValueChanged="OnFondeadoraChanged" Required="true"                          
                           Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="0">Seleccionar una empresa</MudSelectItem>
                    @foreach (var emp in _fondeadoras)
                    {
                        <MudSelectItem Value="@emp.NumEmpresa">@emp.RazonSocial</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudDatePicker Label="Fecha de la Solicitud" @bind-Date="_fechaSolicitud" Editable="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CalendarToday" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudDatePicker Label="Entrega del Préstamo" Date="_fechaEntrega" Editable="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                               DateChanged="@(async (DateTime? d) => await OnFechaEntregaChanged(d))" />
            </MudItem>

            @* Fila 2: Empleado, Nombre, Sueldo *@
            <MudItem xs="12" md="2">
                <MudNumericField T="int" Label="Empleado" @bind-Value="_empleadoIdBuscar" 
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                                 OnAdornmentClick="BuscarEmpleado"
                                 OnKeyDown="OnEmpleadoKeyDown" />
            </MudItem>
            <MudItem xs="12" md="7">
                @if (_empleadoSeleccionado is not null)
                {
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mt-2" Style="font-weight: bold;">
                        @_empleadoSeleccionado.NombreCompleto
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-3">
                        Ingrese el ID del empleado y presione Enter o haga clic en la lupa
                    </MudText>
                }
            </MudItem>
            <MudItem xs="12" md="2">
                <MudText Typo="Typo.body1">Sueldo Laboral</MudText>
                <MudText Typo="Typo.h6" Color="Color.Warning" Style="font-weight: bold;">
                    @((_empleadoSeleccionado?.SueldoLaboral ?? 0).ToString("C2"))
                </MudText>
            </MudItem>
           @*  <MudItem xs="12" md="2" /> *@

            @* Fila 3: Tipo de Préstamo, Observaciones, Total Solicitud *@
            @if (!EsCajaDeAhorro)
            {
                <MudItem xs="12" md="3">
                    <MudSelect T="int" Label="Tipo de Préstamo" @bind-Value="_model.TipoPrestamoId" Required="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var tp in _tiposPrestamo)
                        {
                            <MudSelectItem Value="@tp.TipoPrestamoId">@tp.Descripcion</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" md="@(EsCajaDeAhorro ? 9 : 6)">
                <MudTextField T="string" Label="Observaciones / Motivo" @bind-Value="_model.DestinoCredito"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Elevation="0" Class="pa-2" Style="background: var(--mud-palette-primary); border-radius: 4px; height: 100%;">
                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.8);">Total Solicitud (Nómina + Directos)</MudText>
                    <MudText Typo="Typo.h6" Style="color: white; font-weight: bold;">
                        @TotalSolicitud.ToString("C2")
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ── Sección: Préstamos Directos (ancho completo, layout horizontal) ── *@
    <MudPaper Elevation="1" Class="pa-4 mt-1" Style="border-radius: 0;">
        <div class="d-flex align-center justify-space-between mb-3" Style="border-bottom: 2px solid var(--mud-palette-primary); padding-bottom: 4px;">
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight: bold;">
                <MudIcon Icon="@Icons.Material.Filled.AddCard" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                Préstamos Directos
            </MudText>
            <div class="d-flex align-center gap-4">
                @if (_prestamosDirectos.Count > 0)
                {
                    <MudText Typo="Typo.body2" Style="font-weight: bold;">
                        Total: <span style="color: var(--mud-palette-primary);">@_prestamosDirectos.Sum(p => p.MontoSolicitado).ToString("C2")</span>
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Calculate" OnClick="SimularAmortizacion">
                        Recalcular
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarPrestamoDirecto">
                    Agregar Préstamo Directo
                </MudButton>
            </div>
        </div>

        @if (_prestamosDirectos.Count == 0)
        {
            <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Dense="true">
                No hay préstamos directos. Haga clic en <b>Agregar Préstamo Directo</b> para incluir uno.
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="1">
                @foreach (var (prestamo, idx) in _prestamosDirectos.Select((p, i) => (p, i)))
                {
                    <div class="d-flex align-center gap-4" Style="border-bottom: 1px solid var(--mud-palette-primary); padding-bottom: 1px;">
                    <MudItem xs="12" md="2">
                        <MudTextField T="string" Label="@($"#{idx + 1} Descripción")" @bind-Value="prestamo.Descripcion"
                                      Margin="Margin.Dense" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudNumericField T="decimal" Label="Monto Solicitado" @bind-Value="prestamo.MontoSolicitado"
                                         Format="N2" Min="1m" Step="1000" Margin="Margin.Dense"
                                         Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="$" />
                    </MudItem>
                    <MudItem xs="6" md="1">
                        <MudNumericField T="decimal" Label="Tasa Mensual %" @bind-Value="prestamo.TasaMensual"
                                         Format="N2" Min="0.01m" Step="0.5m" Margin="Margin.Dense"
                                         Variant="Variant.Outlined"
                                         ReadOnly="@EsCajaDeAhorro" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudDatePicker Label="Fecha de Pago" Date="@prestamo.FechaPago"
                                       DateChanged="@((DateTime? d) => { prestamo.FechaPago = d ?? DateTime.Today; prestamo.DiazPlazo = Math.Max(1, (prestamo.FechaPago - (_fechaEntrega ?? DateTime.Today)).Days); })"
                                       Margin="Margin.Dense" Variant="Variant.Outlined" Editable="true" />
                    </MudItem>
                    <MudItem xs="6" md="1">
                        <MudNumericField T="int" Label="Días Plazo" Value="@prestamo.DiazPlazo"
                                         ReadOnly="true" Margin="Margin.Dense"
                                         Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6" md="2">
                        @{
                            var intPD = Math.Round(prestamo.MontoSolicitado * (prestamo.TasaMensual/100) * (prestamo.DiazPlazo / 30m), 2);
                            var totalPD = prestamo.MontoSolicitado + intPD;
                        }
                        <MudPaper Elevation="0" Class="pa-2" Style="background: var(--mud-palette-background-grey); border-radius: 4px; height: 100%;">
                            <MudText Typo="Typo.button" Color="Color.Secondary">Intereses: <b>@intPD.ToString("C2")</b></MudText><br />
                            <MudText Typo="Typo.button" Color="Color.Primary" Style="font-weight: bold;">Total: @totalPD.ToString("C2")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="1" Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                       Size="Size.Medium" Title="Eliminar préstamo directo"
                                       OnClick="@(() => EliminarPrestamoDirecto(idx))" />
                    </MudItem>
                    </div>
                }
            </MudGrid>
        }
    </MudPaper>

    @* ── CUERPO: 3 Paneles ── *@
    <MudGrid Spacing="1" Class="pa-0 mt-1" Style="border-radius: 0;">
        @* ── Panel Izquierdo: Datos del Préstamo ── *@
        <MudItem xs="12" md="3">
            <MudPaper Elevation="1" Class="pa-4" Style="min-height: 480px; border-radius: 0;">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-4" Style="font-weight: bold; border-bottom: 2px solid var(--mud-palette-primary); padding-bottom: 4px;">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                    Datos del Préstamo Nómina
                </MudText>

                <MudNumericField T="decimal" Label="Importe Solicitado" @bind-Value="_model.MontoAprobado"
                                 Format="N0" Min="1000m" Step="10000" Required="true"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                 Adornment="Adornment.End" AdornmentText="$" 
                                 DebounceInterval="500" OnDebounceIntervalElapsed="SimularAmortizacion" />

                <MudNumericField T="decimal" Label="Tasa de Interés Mensual" @bind-Value="_tasaMensual"
                                 Format="N2" Min="0.01m" Required="true"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                 Adornment="Adornment.End" AdornmentText="%"
                                 ReadOnly="@EsCajaDeAhorro"
                                 DebounceInterval="500" OnDebounceIntervalElapsed="SimularAmortizacion" />

                <MudNumericField T="int" Label="Plazo (Meses)" @bind-Value="_model.PlazoMeses"
                                 Min="1" Max="360" Required="true"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                 ReadOnly="@EsCajaDeAhorro"
                                 DebounceInterval="500" OnDebounceIntervalElapsed="SimularAmortizacion" />

                <MudSelect T="bool" Label="Vencimiento" Value="_vencimientoManual"
                           ValueChanged="@((bool v) => { _vencimientoManual = v; if (!v) { RecalcularFechas(); } })"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    <MudSelectItem Value="false">Calculado Automático</MudSelectItem>
                    <MudSelectItem Value="true">Asignar Fecha</MudSelectItem>
                </MudSelect>

                @if (EsCajaDeAhorro)
                {
                    <MudDatePicker Label="Fecha Final de Descuento / Vencimiento"
                                   Date="_fechaFinalDescuento" Editable="true"
                                   ReadOnly="@(!_vencimientoManual)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                   MaxDate="@FechaCierreCajaEfectiva"
                                   DateChanged="OnFechaVencimientoManualCajaChanged"
                                   HelperText="@(_vencimientoManual
                                       ? $"Máximo: {FechaCierreCajaEfectiva?.ToString("dd/MM/yyyy") ?? "—"} (cierre de caja)"
                                       : "Calculado automáticamente al cierre de caja")" />
                }
                else
                {
                    <MudDatePicker Label="Fecha Final de Descuento / Vencimiento"
                                   Date="_fechaFinalDescuento" Editable="true"
                                   ReadOnly="@(!_vencimientoManual)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                   DateChanged="@((DateTime? d) => { if (_vencimientoManual) { _fechaFinalDescuento = d; RecalcularFechas(); } })" />
                }

                <MudSelect T="int" Label="Frecuencia de Pago" Value="_model.TipoPagoId"
                           ValueChanged="OnFrecuenciaPagoChanged" Required="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    @foreach (var tp in _tiposPago)
                    {
                        <MudSelectItem Value="@tp.TipoPagoId">@tp.Descripcion</MudSelectItem>
                    }
                </MudSelect>

                <div class="d-flex gap-2 mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Calculate" OnClick="SimularAmortizacion"
                               Disabled="@(!PuedeSimular)">
                        Calcular
                    </MudButton>
                </div>
            </MudPaper>
        </MudItem>

        @* ── Panel Central: Tabla de Amortización ── *@
        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="pa-4" Style="min-height: 480px; border-radius: 0;">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-4" 
                         Style="font-weight: bold; border-bottom: 2px solid var(--mud-palette-primary); padding-bottom: 4px;">
                    <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                    Amortizaciones del Préstamo
                </MudText>

                @if (_simulando)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else if (_preview is null || _preview.TablaAmortizacion.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Class="my-4">
                        Complete los datos del préstamo y presione <b>Calcular</b> para generar la tabla de amortización.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="@_preview.TablaAmortizacion" Dense="true" Hover="true" Bordered="true"
                              Striped="true" FixedHeader="true" Height="400px" Style="font-size: 0.85rem;">
                        <HeaderContent>
                            <MudTh Style="width: 60px; text-align: center;"># PAGO</MudTh>
                            <MudTh>FECHA PAGO</MudTh>
                            <MudTh Style="text-align: right;">CUOTA</MudTh>
                            <MudTh Style="text-align: right;">INTERÉS</MudTh>
                            <MudTh Style="text-align: right;">CAPITAL</MudTh>                            
                            <MudTh Style="text-align: right;">SALDO DE CAPITAL</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Style="text-align: center;">@context.NumeroPago</MudTd>
                            <MudTd>@context.FechaPago.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd Style="text-align: right;">@context.ImportePago.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right;">@context.ImporteInteres.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right;">@context.ImporteCapital.ToString("N2")</MudTd>                            
                            <MudTd Style="text-align: right;">@context.SaldoFinal.ToString("N2")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>

        @* ── Panel Derecho: Resumen del Préstamo ── *@
        <MudItem xs="12" md="3">
            <MudPaper Elevation="1" Class="pa-4" Style="min-height: 480px; border-radius: 0;">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-4" Style="font-weight: bold; border-bottom: 2px solid var(--mud-palette-primary); padding-bottom: 4px;">
                    <MudIcon Icon="@Icons.Material.Filled.Summarize" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                    Resumen del Préstamo
                </MudText>

                @if (_preview is not null)
                {
                    <MudSimpleTable Dense="true" Hover="true" Bordered="false" Style="border: none;">
                        <tbody>
                            <tr>
                                <td><MudText Typo="Typo.body2">Préstamos Directos</MudText></td>
                                <td style="text-align: right;"><MudText Typo="Typo.body2" Style="font-weight: bold;">@TotalSolicitud.ToString("N2")</MudText></td>
                            </tr>
                            <tr>
                                <td><MudText Typo="Typo.body2">Capital Amortizable</MudText></td>
                                <td style="text-align: right;"><MudText Typo="Typo.body2" Style="font-weight: bold;">@_preview.CapitalAmortizable.ToString("N2")</MudText></td>
                            </tr>
                            <tr>
                                <td><MudText Typo="Typo.body2">Total de Intereses</MudText></td>
                                <td style="text-align: right;"><MudText Typo="Typo.body2" Style="font-weight: bold;">@_preview.TotalIntereses.ToString("N2")</MudText></td>
                            </tr>
                            <tr style="border-top: 2px solid var(--mud-palette-primary);">
                                <td><MudText Typo="Typo.body1" Style="font-weight: bold;">Total a Pagar</MudText></td>
                                <td style="text-align: right;"><MudText Typo="Typo.body1" Color="Color.Primary" Style="font-weight: bold;">@_preview.TotalPagar.ToString("N2")</MudText></td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>

                    <MudDivider Class="my-4" />

                    <MudSimpleTable Dense="true" Hover="true" Bordered="false" Style="border: none;">
                        <tbody>
                            <tr>
                                <td><MudText Typo="Typo.body2">Cuota por Período</MudText></td>
                                <td style="text-align: right;"><MudText Typo="Typo.body2" Style="font-weight: bold;">@_preview.CuotaMensual.ToString("N2")</MudText></td>
                            </tr>
                            <tr>
                                <td><MudText Typo="Typo.body2">Tasa por Período</MudText></td>
                                <td style="text-align: right;"><MudText Typo="Typo.body2" Style="font-weight: bold;">%@_preview.TasaPorPeriodo.ToString("N4")</MudText></td>
                            </tr>
                            <tr>
                                <td><MudText Typo="Typo.body2">Número de Pagos</MudText></td>
                                <td style="text-align: right;"><MudText Typo="Typo.body2" Style="font-weight: bold;">@_preview.NumeroPagos</MudText></td>
                            </tr>
                            <tr>
                                <td><MudText Typo="Typo.body2">Días de Plazo</MudText></td>
                                <td style="text-align: right;"><MudText Typo="Typo.body2" Style="font-weight: bold;">@_preview.DiasPlayzo</MudText></td>
                            </tr>
                            <tr>
                                <td><MudText Typo="Typo.body2">Fecha del último Pago</MudText></td>
                                <td style="text-align: right;"><MudText Typo="Typo.body2" Style="font-weight: bold;">@_preview.FechaUltimoPago.ToString("dd/MM/yyyy")</MudText></td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                }
                else
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Class="mt-4">
                        El resumen se mostrará después de calcular la amortización.
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    
</MudForm>

@* ── Diálogo: Confirmar Salida sin Guardar ── *@
<MudDialog @bind-Visible="_confirmarSalidaVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false })">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Warning">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" Style="vertical-align: middle;" />
            Salir sin guardar
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-2">
            Tiene cambios sin guardar en la solicitud de préstamo.
        </MudAlert>
        <MudText Typo="Typo.body2">
            ¿Está seguro de que desea salir? Los datos capturados <b>se perderán</b> si no guarda antes de continuar.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelarSalida" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Edit">
            Continuar captura
        </MudButton>
        <MudSpacer />
        <MudButton OnClick="ConfirmarSalida" Variant="Variant.Text" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.ExitToApp">
            Salir sin guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@* ── Diálogo: Buscar Empleado ── *@
<MudDialog @bind-Visible="_buscarEmpleadoVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Class="mr-1" Style="vertical-align: middle;" />
            Buscar Empleado
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_busquedaEmpleadoTexto" Placeholder="Buscar por nombre, RFC o número de nómina..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="mb-3" />

        <MudTable Items="@_empleadosFiltrados" Dense="true" Hover="true" Bordered="true" Striped="true"
                  OnRowClick="SeleccionarEmpleadoDesdeTabla" T="EmpleadoListDto" 
                  Style="cursor: pointer;"
                  @ref="_tablaEmpleados">
            <HeaderContent>
                <MudTh Style="text-align: center;">ID</MudTh>
                <MudTh Style="text-align: center;">Nómina</MudTh>
                <MudTh>Nombre</MudTh>
                <MudTh>RFC</MudTh>
                <MudTh>Empresa</MudTh>
