@* ── Diálogo: Confirmar Guardado ── *@
<MudDialog @bind-Visible="_confirmarGuardadoVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" Style="vertical-align: middle;" />
            Confirmar Solicitud
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-4">
            ¿Está seguro de registrar la solicitud con los siguientes datos?
        </MudAlert>
        <MudSimpleTable Dense="true">
            <tbody>
                <tr><td>Empleado</td><td><b>@(_empleadoSeleccionado?.NombreCompleto ?? "—")</b></td></tr>
                <tr><td>Monto</td><td><b>@_model.MontoAprobado.ToString("C2")</b></td></tr>
                <tr><td>Plazo</td><td><b>@_model.PlazoMeses meses</b></td></tr>
                <tr><td>Tasa Mensual</td><td><b>@_tasaMensual.ToString("N2")%</b></td></tr>
                <tr><td>Cuota por Período</td><td><b>@(_preview?.CuotaMensual.ToString("C2") ?? "—")</b></td></tr>
                <tr><td>Número de Pagos</td><td><b>@(_preview?.NumeroPagos.ToString() ?? "—")</b></td></tr>
                <tr><td>Total a Pagar</td><td><b>@(_preview?.TotalPagar.ToString("C2") ?? "—")</b></td></tr>
            </tbody>
        </MudSimpleTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _confirmarGuardadoVisible = false)" Variant="Variant.Text">Cancelar</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="EjecutarGuardar"
                   Disabled="@_saving" StartIcon="@(_saving ? null : Icons.Material.Filled.Save)">
            @if (_saving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Guardando...</MudText>
            }
            else
            {
                <MudText>Confirmar y Guardar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int? PrestamoEditId { get; set; }

    // ── Modelo ──
    private PrestamoCreateDto _model = new()
    {
        DestinoCredito = string.Empty,
        FechaEntrega = DateTime.Today,
        PlazoMeses = 1,
        MontoAprobado = 0
    };

    private decimal _tasaMensual = 5;
    private DateTime? _fechaSolicitud = DateTime.Today;
    private DateTime? _fechaEntrega = DateTime.Today;
    // Única fuente de verdad para la fecha final de descuento / vencimiento.
    // En modo "auto" se calcula; en modo "manual" la escribe el usuario.
    private DateTime? _fechaFinalDescuento;
    private bool _vencimientoManual = false;
    private int _prestamoId;

    // ── Catálogos ──
    private List<EmpresaListDto> _fondeadoras = [];
    private List<TipoPrestamoDto> _tiposPrestamo = [];
    private List<TipoPagoDto> _tiposPago = [];
    private ParametrosDto _parametros = new();
    private ParametrosDto? _parametrosProximoAnio;
    // private int _condicionCreditoId;

    /// <summary>
    /// Fecha de cierre de caja de ahorro vigente según la fecha de entrega:
    /// - Si la fecha de entrega es anterior o igual al cierre del año actual → CierreCajaAnual del año actual.
    /// - Si es posterior al cierre del año actual → CierreCajaAnual del año siguiente (requiere que esté capturado).
    /// Retorna null cuando aún no hay datos suficientes.
    /// </summary>
    private DateTime? FechaCierreCajaEfectiva
    {
        get
        {
            if (!EsCajaDeAhorro) return null;

            DateTime entrega = _fechaEntrega ?? DateTime.Today;
            DateTime? cierreActual = _parametros.CierreCajaAnual;

            if (cierreActual.HasValue && entrega <= cierreActual.Value)
                return cierreActual;

            // El préstamo es posterior al cierre actual → usar el del año siguiente
            return _parametrosProximoAnio?.CierreCajaAnual;
        }
    }

    // ── Empleado ──
    private int _empleadoIdBuscar;
    private EmpleadoDetailDto? _empleadoSeleccionado;
    private bool _buscarEmpleadoVisible;
    private string _busquedaEmpleadoTexto = "";
    private List<EmpleadoListDto> _todosEmpleados = [];
    private MudTable<EmpleadoListDto> _tablaEmpleados = null!;

    private IEnumerable<EmpleadoListDto> _empleadosFiltrados =>
        string.IsNullOrWhiteSpace(_busquedaEmpleadoTexto)
            ? _todosEmpleados
            : _todosEmpleados.Where(e =>
                e.NombreCompleto.Contains(_busquedaEmpleadoTexto, StringComparison.OrdinalIgnoreCase) ||
                e.Rfc.Contains(_busquedaEmpleadoTexto, StringComparison.OrdinalIgnoreCase) ||
                e.NumeroNomina.ToString().Contains(_busquedaEmpleadoTexto));

    // ── Preview ──
    private AmortizacionPreviewResultDto? _preview;
    private bool _simulando;

    // ── Préstamos Directos ──
    private List<PrestamoDirectoCreateDto> _prestamosDirectos = [];

    // ── Form ──
    private MudForm _form = null!;
    private bool _formValid;
    private bool _saving;
    private bool _confirmarGuardadoVisible;
    private bool _confirmarSalidaVisible;
    private string _pendingNavigationUrl = string.Empty;
    private IDisposable? _locationChangingRegistration;

    private bool PuedeSimular => 
        _model.FondeadoraId > 0 && 
        _model.EmpleadoId > 0 && 
        (EsCajaDeAhorro || _model.TipoPrestamoId > 0) && 
        _model.MontoAprobado > 0 && 
        _model.PlazoMeses > 0 && 
        _tasaMensual > 0;

    private bool EsCajaDeAhorro => 
        _fondeadoras.FirstOrDefault(f => f.NumEmpresa == _model.FondeadoraId)?.IsCajaDeAhorro ?? false;

    private decimal TotalSolicitud =>
        _model.MontoAprobado + _prestamosDirectos.Sum(p => p.MontoSolicitado);

    private bool FormularioModificado =>
        _model.FondeadoraId > 0 ||
        _model.EmpleadoId > 0 ||
        _model.MontoAprobado > 0 ||
        !string.IsNullOrWhiteSpace(_model.DestinoCredito) ||
        _prestamosDirectos.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        _locationChangingRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChanging);
        try
        {
            var empresasTask = EmpresasApi.GetEmpresasAsync();
            var tiposPrestamoTask = CatalogosApi.GetTiposPrestamoAsync();
            var tiposPagoTask = CatalogosApi.GetTiposPagoAsync();
            var empleadosTask = EmpleadosApi.GetEmpleadosAsync();
            var parametrosTask = ParametrosApi.GetParametrosAsync(DateTime.Today.Year);

            await Task.WhenAll(empresasTask, tiposPrestamoTask, tiposPagoTask, empleadosTask, parametrosTask);

            _fondeadoras = empresasTask.Result;
            _tiposPrestamo = tiposPrestamoTask.Result;
            _tiposPago = tiposPagoTask.Result;
            _todosEmpleados = empleadosTask.Result;
            _parametros = parametrosTask.Result;

            if (_tiposPago.Count > 0)
                _model.TipoPagoId = _tiposPago[0].TipoPagoId;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar catálogos: {ex.Message}", Severity.Error);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PrestamoEditId.HasValue && PrestamoEditId.Value > 0)
        {
            await CargarPrestamoParaEdicion(PrestamoEditId.Value);
        }
    }

    private async Task CargarPrestamoParaEdicion(int prestamoId)
    {
        try
        {
            var detalle = await PrestamosApi.GetByIdAsync(prestamoId);
            if (detalle == null)
            {
                Snackbar.Add($"No se encontró el préstamo con ID {prestamoId}", Severity.Warning);
                return;
            }

            _prestamoId = detalle.Id;
            _fechaSolicitud = detalle.FechaSolicitud;
            _fechaEntrega = detalle.FechaDeposito ?? detalle.FechaAprobado;
            _model.FechaEntrega = _fechaEntrega ?? DateTime.Today;
            _model.MontoAprobado = detalle.MontoAprobado;
            _model.PlazoMeses = detalle.PlazoMeses;
            _model.DestinoCredito = detalle.DestinoCredito;
            _tasaMensual = detalle.TasaInteresMensual;
            _model.TasaInteresMensual = detalle.TasaInteresMensual;
            _fechaFinalDescuento = detalle.FinalDescuento;

            // Asignar IDs directamente desde el detalle
            _model.EmpleadoId = detalle.EmpleadoId;
            _model.FondeadoraId = detalle.FuenteFondeoId;
            _model.TipoPrestamoId = detalle.TipoPrestamoId;
            _model.TipoPagoId = detalle.TipoPagoId;

            // Cargar empleado para mostrar su información
            _empleadoIdBuscar = detalle.EmpleadoId;
            await CargarEmpleadoPorId(detalle.EmpleadoId);

            // Cargar préstamos directos existentes
            if (detalle.PrestamosDirectos?.Count > 0)
            {
                _prestamosDirectos = detalle.PrestamosDirectos
                    .Select(pd => new PrestamoDirectoCreateDto
                    {
                        Descripcion = pd.Descripcion,
                        MontoSolicitado = pd.MontoSolicitado,
                        TasaMensual = pd.TasaMensual,
                        FechaPago = pd.FechaPago,
                        DiazPlazo = pd.DiazPlazo
                    }).ToList();
            }

            // Crear el preview con la tabla de amortización completa
            _preview = new AmortizacionPreviewResultDto
            {
                CapitalAmortizable = detalle.MontoAprobado,
                TotalIntereses = detalle.TablaAmortizacion?.Sum(a => a.ImporteInteres) ?? 0,
                TotalPagar = detalle.TotalPagar,
                CuotaMensual = detalle.ImporteCuotas,
                TasaPorPeriodo = detalle.TasaInteresMensual,
                NumeroPagos = detalle.NumeroCuotas,
                FechaUltimoPago = detalle.FinalDescuento,
                DiasPlayzo = (detalle.FinalDescuento - detalle.InicioDescuento).Days,
                PagosAdicionalesCapital = 0,
                TablaAmortizacion = detalle.TablaAmortizacion ?? [],
                PrestamosDirectos = detalle.PrestamosDirectos?.Select(pd => new PrestamoDirectoDto
                {
                    NumPrestamoDirecto = pd.NumPrestamoDirecto,
                    PrestamoId = pd.PrestamoId,
                    Descripcion = pd.Descripcion,
                    MontoSolicitado = pd.MontoSolicitado,
                    TasaMensual = pd.TasaMensual,
                    FechaPago = pd.FechaPago,
                    DiazPlazo = pd.DiazPlazo,
                    MontoIntereses = pd.MontoIntereses,
                    TotalCapitalInteres = pd.TotalCapitalInteres
                }).ToList() ?? []
            };

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar el préstamo: {ex.Message}", Severity.Error);
        }
    }

    // ── Empleado ──

    private async Task BuscarEmpleado()
    {
        if (_empleadoIdBuscar <= 0)
        {
            _buscarEmpleadoVisible = true;
            return;
        }

        await CargarEmpleadoPorId(_empleadoIdBuscar);
    }

    private async Task OnEmpleadoKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarEmpleado();
        }
    }

    private async Task CargarEmpleadoPorId(int id)
    {
        try
        {
            _empleadoSeleccionado = await EmpleadosApi.GetEmpleadoByIdAsync(id);
            if (_empleadoSeleccionado is null)
            {
                Snackbar.Add($"Empleado con ID {id} no encontrado.", Severity.Warning);
                return;
            }

            _model.EmpleadoId = _empleadoSeleccionado.EmpleadoId;
            _empleadoIdBuscar = _empleadoSeleccionado.EmpleadoId;

            if (_empleadoSeleccionado.TipoPagoId > 0)
                _model.TipoPagoId = _empleadoSeleccionado.TipoPagoId;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al buscar empleado: {ex.Message}", Severity.Error);
        }
    }

    private async Task SeleccionarEmpleadoDesdeTabla(TableRowClickEventArgs<EmpleadoListDto> args)
    {
        if (args.Item == null) return;
        _buscarEmpleadoVisible = false;
        _empleadoIdBuscar = args.Item.EmpleadoId;
        await CargarEmpleadoPorId(args.Item.EmpleadoId);
    }

    // ── Simulación ──

    /// <summary>
    /// Verifica si la fecha de entrega supera el cierre de caja del año actual;
    /// si es así, carga los parámetros del año siguiente y reporta error si no existen.
    /// </summary>
    private async Task VerificarParametrosProxAnioAsync()
    {
        if (!EsCajaDeAhorro) return;

        DateTime entrega = _fechaEntrega ?? DateTime.Today;
        DateTime? cierreActual = _parametros.CierreCajaAnual;

        if (!cierreActual.HasValue || entrega <= cierreActual.Value)
        {
            _parametrosProximoAnio = null;
            return;
        }

        // Necesitamos el siguiente año
        int anioSiguiente = entrega.Year + (entrega.Month >= 11 ? 1 : 0);
        if (_parametrosProximoAnio?.Anio == anioSiguiente) return; // ya cargado

        try
        {
            var p = await ParametrosApi.GetParametrosAsync(anioSiguiente);
            if (p.CierreCajaAnual is null)
            {
                Snackbar.Add(
                    $"El cierre anual de caja de ahorro del año {anioSiguiente} no ha sido capturado. " +
                    "Configúrelo en Parámetros Generales antes de continuar.",
                    Severity.Error);
                _parametrosProximoAnio = null;
            }
            else
            {
                _parametrosProximoAnio = p;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar parámetros de {anioSiguiente}: {ex.Message}", Severity.Error);
            _parametrosProximoAnio = null;
        }
    }

    private void OnFechaVencimientoManualCajaChanged(DateTime? fecha)
    {
        if (!EsCajaDeAhorro || fecha is null)
        {
            _fechaFinalDescuento = fecha;
            RecalcularFechas();
            return;
        }

        DateTime? cierre = FechaCierreCajaEfectiva;

        // Primero limitar al cierre de caja
        DateTime fechaEfectiva = cierre.HasValue && fecha.Value > cierre.Value
            ? cierre.Value
            : fecha.Value;

        // Ajustar a la fecha de nómina más cercana anterior o igual
        DateTime? fechaNomina = AjustarAFechaNomina(fechaEfectiva);

        if (fechaNomina is null)
        {
            // Sin calendario de nómina aplicable, usar la fecha efectiva tal cual
            _fechaFinalDescuento = fechaEfectiva;
            RecalcularFechas();
            return;
        }

        if (fechaNomina.Value != fechaEfectiva)
        {
            Snackbar.Add(
                $"La fecha fue ajustada al corte de nómina más próximo: {fechaNomina.Value:dd/MM/yyyy}.",
                Severity.Info);
        }

        if (cierre.HasValue && fechaNomina.Value > cierre.Value)
        {
            Snackbar.Add(
                $"La fecha de vencimiento no puede exceder el cierre de caja ({cierre.Value:dd/MM/yyyy}).",
                Severity.Warning);
            _fechaFinalDescuento = cierre;
        }
        else
        {
            _fechaFinalDescuento = fechaNomina;
        }

        RecalcularFechas();
    }

    /// <summary>
    /// Devuelve la fecha de nómina más cercana que sea ≤ <paramref name="fecha"/>.
    /// Usa el calendario del tipo de pago seleccionado (semanal/catorcenal).
    /// Retorna <c>null</c> cuando no aplica calendario de nómina (mensual, quincenal, etc.).
    /// </summary>
    private DateTime? AjustarAFechaNomina(DateTime fecha)
    {
        var tipoPago = _tiposPago.FirstOrDefault(tp => tp.TipoPagoId == _model.TipoPagoId);
        if (tipoPago is null) return null;

        DateTime? inicioPeriodo = tipoPago.IntervaloDiario switch
        {
            7  => _parametros.InicioPeriodoSemanal,
            14 => _parametros.InicioPeriodoCatorcenal,
            _  => null
        };

        if (inicioPeriodo is null) return null;

        int intervalo = tipoPago.IntervaloDiario;

        // Avanzar desde el inicio hasta superar la fecha objetivo,
        // luego retroceder un paso para obtener la última fecha ≤ fecha.
        DateTime cursor = inicioPeriodo.Value;
        while (cursor <= fecha)
            cursor = cursor.AddDays(intervalo);

        return cursor.AddDays(-intervalo);
    }

    private async Task OnFondeadoraChanged(int fondeadoraId)
    {
        _model.FondeadoraId = fondeadoraId;

        // Si es Caja de Ahorro, establecer automáticamente el tipo de préstamo a Corto Plazo
        // y aplicar las tasas fijas desde parámetros generales
        if (EsCajaDeAhorro)
        {
            var cortoPlazoTipo = _tiposPrestamo.FirstOrDefault(tp => tp.Clasificacion == PrestamosUcayNet.Domain.Enums.ClasificacionTipoPrestamo.CortoPlazo);
            if (cortoPlazoTipo != null)
                _model.TipoPrestamoId = cortoPlazoTipo.TipoPrestamoId;

            if (_parametros.TasaFijaCaja.HasValue)
                _tasaMensual = _parametros.TasaFijaCaja.Value;

            await VerificarParametrosProxAnioAsync();
            RecalcularFechas();
        }
        else
        {
            _parametrosProximoAnio = null;
            if (_parametros.TasaFijaEmpresa.HasValue)
                _tasaMensual = _parametros.TasaFijaEmpresa.Value;
        }

        StateHasChanged();
    }

    private async Task OnFrecuenciaPagoChanged(int tipoPagoId)
    {
        _model.TipoPagoId = tipoPagoId;
        await SimularAmortizacion();
    }

    private async Task OnFechaEntregaChanged(DateTime? newDate)
    {
        _fechaEntrega = newDate;
        _model.FechaEntrega = newDate ?? DateTime.Today;
        if (EsCajaDeAhorro)
            await VerificarParametrosProxAnioAsync();
        RecalcularFechas();
    }

    private void RecalcularFechas()
    {
        if (!_fechaEntrega.HasValue) return;

        if (EsCajaDeAhorro)
        {
            if (!_vencimientoManual || !_fechaFinalDescuento.HasValue)
            {
                // Modo automático: siempre usar el cierre de caja
                _fechaFinalDescuento = FechaCierreCajaEfectiva ?? _fechaEntrega.Value.AddMonths(_model.PlazoMeses);
            }
            // Modo manual: _fechaFinalDescuento ya fue fijada por el picker; no sobreescribir.

            // Plazo en meses siempre derivado de la fecha final de descuento
            int meses = (int)Math.Ceiling(
                (_fechaFinalDescuento!.Value - _fechaEntrega.Value).TotalDays / 30.4375);
            _model.PlazoMeses = Math.Max(1, meses);
        }
        else if (_model.PlazoMeses > 0)
        {
            _fechaFinalDescuento = _fechaEntrega.Value.AddMonths(_model.PlazoMeses);
        }
    }

    private async Task SimularAmortizacion()
    {
        if (!PuedeSimular) return;

        _simulando = true;
        RecalcularFechas();

        try
        {
            _model.TasaInteresMensual = _tasaMensual;

            var tipoPagoSeleccionado = _tiposPago.FirstOrDefault(tp => tp.TipoPagoId == _model.TipoPagoId);

            // Seleccionar la fecha de inicio de período según la frecuencia de pago
            DateTime? fechaInicioPeriodo = tipoPagoSeleccionado?.IntervaloDiario switch
            {
                7  => _parametros.InicioPeriodoSemanal,
                14 => _parametros.InicioPeriodoCatorcenal,
                _  => null
            };

            var dto = new SimularAmortizacionDto
            {
                MontoAprobado = _model.MontoAprobado,
                PlazoMeses = _model.PlazoMeses,
                TasaInteresAnual = _tasaMensual * 12m,
                FechaEntrega = _fechaEntrega ?? DateTime.Today,
                IntervaloDiario = tipoPagoSeleccionado?.IntervaloDiario ?? 30,
                FrecuenciaAnual = tipoPagoSeleccionado?.FrecuenciaAnual ?? 12,
                FechaInicioPeriodo = fechaInicioPeriodo,
                // Para Caja de Ahorro, el cap es siempre _fechaFinalDescuento (que en modo auto
                // ya contiene FechaCierreCajaEfectiva y en modo manual la fecha validada).
                FechaCierreCaja = EsCajaDeAhorro ? _fechaFinalDescuento ?? FechaCierreCajaEfectiva : null,
                PrestamosDirectos = _prestamosDirectos
            };

            _preview = await PrestamosApi.SimularAmortizacionAsync(dto);

            if (_preview is not null)
            {
                DateTime ultimaFechaTabla = _preview.FechaUltimoPago;

                // Si la fecha final de descuento no coincide con la última fecha real
                // de la tabla, se ajusta automáticamente a esa fecha.
                if (_fechaFinalDescuento.HasValue &&
                    _fechaFinalDescuento.Value.Date != ultimaFechaTabla.Date)
                {
                    Snackbar.Add(
                        $"La fecha de vencimiento fue ajustada a la última amortización: {ultimaFechaTabla:dd/MM/yyyy}.",
                        Severity.Info);
                }

                _fechaFinalDescuento = ultimaFechaTabla;

                if (_fechaEntrega.HasValue)
                {
                    int meses = (int)Math.Ceiling(
                        (ultimaFechaTabla - _fechaEntrega.Value).TotalDays / 30.4375);
                    _model.PlazoMeses = Math.Max(1, meses);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al simular amortización: {ex.Message}", Severity.Error);
        }
        finally
        {
            _simulando = false;
        }
    }

    // ── Guardar ──

    private async Task GuardarPrestamo()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        if (_model.FondeadoraId <= 0)
        {
            Snackbar.Add("Debe seleccionar una fuente de fondeo.", Severity.Warning);
            return;
        }

        if (_model.EmpleadoId <= 0)
        {
            Snackbar.Add("Debe seleccionar un empleado.", Severity.Warning);
            return;
        }

        // Solo validar tipo de préstamo si no es Caja de Ahorro (ya se establece automáticamente)
        if (!EsCajaDeAhorro && _model.TipoPrestamoId <= 0)
        {
            Snackbar.Add("Debe seleccionar un tipo de préstamo.", Severity.Warning);
            return;
        }

        if (_model.MontoAprobado <= 0)
        {
            Snackbar.Add("El monto solicitado debe ser mayor a cero.", Severity.Warning);
            return;
        }

        if (_model.PlazoMeses <= 0)
        {
            Snackbar.Add("El plazo debe ser mayor a cero.", Severity.Warning);
            return;
        }

        if (_tasaMensual <= 0)
        {
            Snackbar.Add("La tasa de interés debe ser mayor a cero.", Severity.Warning);
            return;
        }

        if (_preview is null)
        {
            Snackbar.Add("Debe calcular la amortización antes de guardar.", Severity.Warning);
            return;
        }

        // Validaciones específicas de Caja de Ahorro
        if (EsCajaDeAhorro)
        {
            DateTime? cierre = FechaCierreCajaEfectiva;
            if (cierre is null)
            {
                Snackbar.Add(
                    "No se encontró la fecha de cierre de caja de ahorro vigente. " +
                    "Verifique que los Parámetros Generales del año correspondiente estén capturados.",
                    Severity.Error);
                return;
            }

            if (_vencimientoManual && _fechaFinalDescuento.HasValue &&
                _fechaFinalDescuento.Value > cierre.Value)
            {
                Snackbar.Add(
                    $"La fecha de vencimiento manual ({_fechaFinalDescuento.Value:dd/MM/yyyy}) " +
                    $"excede el cierre anual de caja ({cierre.Value:dd/MM/yyyy}).",
                    Severity.Error);
                return;
            }

            if (_fechaFinalDescuento.HasValue && _fechaFinalDescuento.Value > cierre.Value)
            {
                Snackbar.Add(
                    $"La fecha final de descuento ({_fechaFinalDescuento.Value:dd/MM/yyyy}) " +
                    $"excede el cierre anual de caja ({cierre.Value:dd/MM/yyyy}).",
                    Severity.Error);
                return;
            }
        }

        _confirmarGuardadoVisible = true;
    }

    private async Task EjecutarGuardar()
    {
        _saving = true;
        try
        {
            // Mapear la tabla de amortización
            _model.Amortizaciones = _preview?.TablaAmortizacion.Select(a => new AmortizacionDto
            {
                NumeroPago = a.NumeroPago,
                FechaPago = a.FechaPago,
                ImportePago = a.ImportePago,
                ImporteInteres = a.ImporteInteres,
                ImporteCapital = a.ImporteCapital,
                PagoExtra = 0,
                SaldoFinal = a.SaldoFinal
            }).ToList() ?? [];

            // Mapear préstamos directos
            _model.PrestamosDirectos = _prestamosDirectos;

            var result = await PrestamosApi.CrearAsync(_model);
            if (result)
            {
                Snackbar.Add("¡Solicitud registrada exitosamente! Será revisada para aprobación.", Severity.Success);
                _confirmarGuardadoVisible = false;
                Navigation.NavigateTo("/gestion-solicitudes");
            }
            else
            {
                Snackbar.Add("Error al registrar la solicitud.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Limpiar ──

    private void LimpiarFormulario()
    {
        _model = new PrestamoCreateDto
        {
            DestinoCredito = string.Empty,
            FechaEntrega = DateTime.Today,
            PlazoMeses = 1,
            MontoAprobado = 0
        };
        _tasaMensual = 5;
        _fechaSolicitud = DateTime.Today;
        _fechaEntrega = DateTime.Today;
        _fechaFinalDescuento = null;
        _empleadoSeleccionado = null;
        _empleadoIdBuscar = 0;
        _preview = null;
        _prestamoId = 0;
        _prestamosDirectos = [];

        if (_tiposPago.Count > 0)
            _model.TipoPagoId = _tiposPago[0].TipoPagoId;

        StateHasChanged();
    }

    // ── Pagos Adicionales ──

    private void AgregarPrestamoDirecto()
    {
        var fechaBase = _fechaEntrega ?? DateTime.Today;
        var fechaPago = fechaBase.AddDays(30);
        var tasaDirecto = EsCajaDeAhorro && _parametros.TasaFijaDirecto.HasValue
            ? _parametros.TasaFijaDirecto.Value
            : _model.TasaInteresMensual;
        _prestamosDirectos.Add(new PrestamoDirectoCreateDto
        {
            Descripcion = string.Empty,
            MontoSolicitado = 0,
            TasaMensual = tasaDirecto,
            FechaPago = fechaPago,
            DiazPlazo = (fechaPago - fechaBase).Days
        });
    }

    private void EliminarPrestamoDirecto(int index)
    {
        if (index >= 0 && index < _prestamosDirectos.Count)
            _prestamosDirectos.RemoveAt(index);
    }

    // ── Intercepción de Navegación ──

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (_saving) return ValueTask.CompletedTask;

        if (FormularioModificado)
        {
            _pendingNavigationUrl = context.TargetLocation;
            context.PreventNavigation();
            _confirmarSalidaVisible = true;
            StateHasChanged();
        }

        return ValueTask.CompletedTask;
    }

    private void ConfirmarSalida()
    {
        _confirmarSalidaVisible = false;
        _locationChangingRegistration?.Dispose();
        _locationChangingRegistration = null;
        Navigation.NavigateTo(_pendingNavigationUrl);
    }

    private void CancelarSalida()
    {
        _confirmarSalidaVisible = false;
        _pendingNavigationUrl = string.Empty;
    }

    public void Dispose()
    {
        _locationChangingRegistration?.Dispose();
    }
}
