@page "/captura-prestamo"
@page "/captura-prestamo/{PrestamoEditId:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador,Gerente,Contador")]
@using PrestamosUcayNet.Application.DTOs
@using PrestamosUcayNet.Domain.Enums
@implements IDisposable
@inject PrestamosApiService PrestamosApi
@inject EmpleadosApiService EmpleadosApi
@inject EmpresasApiService EmpresasApi
@inject CatalogosApiService CatalogosApi
@inject ParametrosApiService ParametrosApi
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Solicitud de Préstamos — Préstamos UcayNet</PageTitle>

@* ── Barra de Título ── *@
<MudPaper Elevation="1" Class="pa-0.5 mb-2" Style="background: var(--mud-palette-primary); color: white; border-radius: 8px 8px 0 0;">
    <div class="d-flex align-center justify-space-between">
        <MudText Typo="Typo.h6" Style="color: white;">
            <MudIcon Icon="@Icons.Material.Filled.RequestPage" Class="mr-1" Style="vertical-align: auto" />
            Solicitud de Préstamos 
        </MudText>
        <div class="d-flex gap-1">
            <MudTooltip Text="Guardar">
                <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Inherit"
                               OnClick="GuardarPrestamo"  Disabled="@(_saving || !_formValid)"/>
            </MudTooltip>
            <MudTooltip Text="Limpiar">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Inherit"
                               OnClick="LimpiarFormulario" />
            </MudTooltip>
            <MudTooltip Text="Regresar a Solicitudes">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit"
                               OnClick="@(() => Navigation.NavigateTo("/gestion-solicitudes"))" />
            </MudTooltip>
        </div>
    </div>
</MudPaper>

<MudForm @ref="_form" @bind-IsValid="_formValid">
    @* ── ENCABEZADO ── *@
    <MudPaper Elevation="1" Class="pa-3 mb-2" Style="border-radius: 0;">

        @* ── Sección 1: Identificación de la solicitud ── *@
        @* <div class="d-flex align-center gap-1 mb-1">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight:700; text-transform:uppercase; letter-spacing:0.5px;">
                Identificación
            </MudText>
            <MudDivider Class="flex-grow-1 ml-1" />
        </div> *@
        <MudGrid Spacing="1" Class="mb-2">
            <MudItem xs="6" md="1">
                <MudTextField T="string" Label="Folio" Value="@(_prestamoId > 0 ? _prestamoId.ToString() : "Nuevo")"
                              ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Tag" />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudSelect T="int" Label="Fuente de Fondeo" Value="_model.FondeadoraId" ValueChanged="OnFondeadoraChanged" Required="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="0">— Seleccionar empresa —</MudSelectItem>
                    @foreach (var emp in _fondeadoras)
                    {
                        <MudSelectItem Value="@emp.NumEmpresa">@emp.RazonSocial</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudDatePicker Label="Fecha Solicitud" @bind-Date="_fechaSolicitud" Editable="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CalendarToday" />
            </MudItem>
            <MudItem xs="6" md="2">
                <MudDatePicker Label="Entrega del Préstamo" Date="_fechaEntrega" Editable="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                               DateChanged="@(async (DateTime? d) => await OnFechaEntregaChanged(d))" />
            </MudItem>
            @if (!EsCajaDeAhorro)
            {
                <MudItem xs="12" md="2">
                    <MudSelect T="int" Label="Tipo de Préstamo" @bind-Value="_model.TipoPrestamoId" Required="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var tp in _tiposPrestamo)
                        {
                            <MudSelectItem Value="@tp.TipoPrestamoId">@tp.Descripcion</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>

        @* ── Sección 2: Empleado ── *@
       @*  <div class="d-flex align-center gap-1 mb-1">
            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight:700; text-transform:uppercase; letter-spacing:0.5px;">
                Empleado
            </MudText>
            <MudDivider Class="flex-grow-1 ml-1" />
        </div> *@
        <MudGrid Spacing="1" Class="mb-2">
            <MudItem xs="6" md="2">
                <MudNumericField T="int" Label="ID Empleado" @bind-Value="_empleadoIdBuscar"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Immediate="true"
                                 Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                                 OnAdornmentClick="BuscarEmpleado"
                                 OnKeyDown="OnEmpleadoKeyDown" HideSpinButtons="true"/>
            </MudItem>
            <MudItem xs="12" md="6">
                @if (_empleadoSeleccionado is not null)
                {
                    <MudPaper Elevation="0" Class="pa-0" Style="background: var(--mud-palette-background-grey); border-radius: 4px; height: 100%; display: flex; align-items: center; gap: 8px;">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Primary" />
                        <div>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:bold; line-height:1.2;">
                                @_empleadoSeleccionado.NombreCompleto
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @_empleadoSeleccionado.EmpresaNombre — @_empleadoSeleccionado.PuestoNombre
                            </MudText>
                        </div>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Elevation="0" Class="pa-0" Style="background: var(--mud-palette-background-grey); border-radius: 4px; height: 100%; display: flex; align-items: center; gap: 8px;">
                        <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Color="Color.Secondary" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Ingrese el ID del empleado y presione <b>Enter</b> o haga clic en la lupa
                        </MudText>
                    </MudPaper>
                }
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Elevation="0" Class="pa-0" Style="background: var(--mud-palette-background-grey); border-radius: 4px; height: 100%;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Sueldo Laboral</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Warning" Style="font-weight:bold;">
                        @((_empleadoSeleccionado?.SueldoLaboral ?? 0).ToString("C2"))
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Elevation="0" Class="pa-0" Style="background: var(--mud-palette-primary); border-radius: 4px; height: 100%;">
                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.8);">Total Solicitud</MudText>
                    <MudText Typo="Typo.h6" Style="color: white; font-weight: bold;">
                        @TotalSolicitud.ToString("C2")
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @* ── Sección 3: Términos del Préstamo ── *@
      @*   <div class="d-flex align-center gap-1 mb-1">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight:700; text-transform:uppercase; letter-spacing:0.5px;">
                Términos
            </MudText>
            <MudDivider Class="flex-grow-1 ml-1" />
        </div> *@
        <MudGrid Spacing="1">
            <MudItem xs="12" md="3">
                <MudSelect T="int" Label="Frecuencia de Pago"
                           Value="@_model.TipoPagoId" ValueChanged="OnFrecuenciaPagoChanged" Required="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           ReadOnly="true"
                           HelperText="Determinada por los datos del empleado">
                    @foreach (var tp in _tiposPago)
                    {
                        <MudSelectItem Value="@tp.TipoPagoId">@tp.Descripcion</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="9">
                <MudTextField T="string" Label="Observaciones / Motivo del Crédito" @bind-Value="_model.DestinoCredito"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ── CUERPO: 3 Paneles ── *@
    <MudGrid Spacing="1" Class="pa-0 mt-1" Style="border-radius: 0;">
        @* ── Panel Izquierdo: Datos del Préstamo ── *@
        <MudItem xs="12" md="3">
            <MudPaper Elevation="1" Class="pa-4" Style="min-height: 480px; border-radius: 0;">
                <div class="d-flex align-center justify-space-between mb-4" Style="border-bottom: 2px solid var(--mud-palette-primary); padding-bottom: 4px;">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight: bold;">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                        Datos del Préstamo Nómina
                    </MudText>
                    @if (EsCajaDeAhorro)
                    {
                        @if (_nominaActiva)
                        {
                            <MudTooltip Text="Limpiar Préstamo Nómina">
                                <MudIconButton Icon="@Icons.Material.Filled.ClearAll" Color="Color.Error"
                                               Size="Size.Small" OnClick="LimpiarPrestamoNomina" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Activar Préstamo Nómina">
                                <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Success"
                                               Size="Size.Small" OnClick="@(() => { _nominaActiva = true; StateHasChanged(); })" />
                            </MudTooltip>
                        }
                    }
                </div>

                @if (!_nominaActiva)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="my-2">
                        Préstamo Nómina <b>no incluido</b> en esta solicitud.
                        Haga clic en <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" Color="Color.Success" /> para activarlo.
                    </MudAlert>
                }
                else
                {
                    <MudNumericField T="decimal" Label="Importe Solicitado" @bind-Value="_model.MontoAprobado"
                                     Format="N0" Min="1000m" Step="10000" Required="true"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                     Adornment="Adornment.End" AdornmentText="$" 
                                     DebounceInterval="500" OnDebounceIntervalElapsed="SimularAmortizacion" />

                    <MudNumericField T="decimal" Label="Tasa de Interés Mensual" @bind-Value="_tasaMensual"
                                     Format="N2" Min="0.01m" Required="true"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                     Adornment="Adornment.End" AdornmentText="%"
                                     ReadOnly="@EsCajaDeAhorro"
                                     DebounceInterval="500" OnDebounceIntervalElapsed="SimularAmortizacion" />

                    <MudNumericField T="int" Label="Plazo (Meses)"
                                     @bind-Value="_model.PlazoMeses"
                                     Min="1" Required="true"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                     ReadOnly="true"
                                     Validation="@((int v) => ValidarPlazo(v))"
                                     HelperText="Calculado automáticamente desde la Fecha Final de Descuento" />

                    @if (EsCajaDeAhorro)
                    {
                        <MudDatePicker Label="Fecha Final de Descuento / Vencimiento"
                                       Date="_fechaFinalDescuento" Editable="true"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                       MaxDate="@FechaCierreCajaEfectiva"
                                       DateChanged="OnFechaVencimientoManualCajaChanged"
                                       HelperText="@($"Máx: {FechaCierreCajaEfectiva?.ToString("dd/MM/yyyy") ?? "—"} (cierre)")" />
                    }
                    else
                    {
                        <MudDatePicker Label="Fecha Final de Descuento"
                                       Date="_fechaFinalDescuento" Editable="true"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                       DateChanged="OnFechaFinalNominaChanged"
                                       HelperText="Modifique la fecha o el plazo; el otro se calculará automáticamente" />
                    }

                    <div class="d-flex gap-2 mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Calculate" OnClick="SimularAmortizacion"
                                   Disabled="@(!PuedeSimular)">
                            Calcular
                        </MudButton>
                    </div>
                }
            </MudPaper>
        </MudItem>

        @* ── Panel Central: Tabla de Amortización ── *@
        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="pa-4" Style="min-height: 480px; border-radius: 0;">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-4" 
                         Style="font-weight: bold; border-bottom: 2px solid var(--mud-palette-primary); padding-bottom: 4px;">
                    <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                    Amortizaciones del Préstamo
                </MudText>

                @if (_simulando)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else if (_preview is null || _preview.TablaAmortizacion.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Class="my-4">
                        Complete los datos del préstamo y presione <b>Calcular</b> para generar la tabla de amortización.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="@_preview.TablaAmortizacion" Dense="true" Hover="true" Bordered="true"
                              Striped="true" FixedHeader="true" Height="400px" Style="font-size: 0.85rem;">
                        <HeaderContent>
                            <MudTh Style="width: 60px; text-align: center;"># PAGO</MudTh>
                            <MudTh>FECHA PAGO</MudTh>
                            <MudTh Style="text-align: right;">CUOTA</MudTh>
                            <MudTh Style="text-align: right;">INTERÉS</MudTh>
                            <MudTh Style="text-align: right;">CAPITAL</MudTh>                            
                            <MudTh Style="text-align: right;">SALDO DE CAPITAL</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Style="text-align: center;">@context.NumeroPago</MudTd>
                            <MudTd>@context.FechaPago.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd Style="text-align: right;">@context.ImportePago.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right;">@context.ImporteInteres.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right;">@context.ImporteCapital.ToString("N2")</MudTd>                            
                            <MudTd Style="text-align: right;">@context.SaldoFinal.ToString("N2")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>

        @* ── Panel Derecho: Resumen del Préstamo ── *@
        <MudItem xs="12" md="3">
            <MudPaper Elevation="1" Class="pa-4" Style="min-height: 480px; border-radius: 0;">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-4" Style="font-weight: bold; border-bottom: 2px solid var(--mud-palette-primary); padding-bottom: 4px;">
                    <MudIcon Icon="@Icons.Material.Filled.Summarize" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                    Resumen del Préstamo
                </MudText>

                @if (_preview is null && _prestamosDirectos.Count == 0)
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Class="mt-4">
                        El resumen se mostrará después de agregar préstamos directos o calcular la amortización.
                    </MudAlert>
                }
                else
                {
                    var _resumenDirectosCapital   = _prestamosDirectos.Sum(p => p.MontoSolicitado);
                    var _resumenDirectosIntereses = _prestamosDirectos.Sum(p =>
                        Math.Round(p.MontoSolicitado * (p.TasaMensual / 100m) * (p.DiazPlazo / 30m), 2));
                    var _resumenDirectosTotal     = _resumenDirectosCapital + _resumenDirectosIntereses;
                    var _resumenNominaTotal        = (_preview is not null && _nominaActiva) ? _preview.TotalPagar : 0m;
                    var _resumenGranTotal          = _resumenDirectosTotal + _resumenNominaTotal;

                    @* ── Sección 1: Préstamos Directos ── *@
                    @if (_prestamosDirectos.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:bold; text-transform:uppercase; letter-spacing:0.5px;">
                            Préstamos Directos
                        </MudText>
                        <MudSimpleTable Dense="true" Bordered="false" Style="border:none; margin-bottom:4px;">
                            <tbody>
                                <tr>
                                    <td><MudText Typo="Typo.body2">Capital</MudText></td>
                                    <td style="text-align:right;"><MudText Typo="Typo.body2" Style="font-weight:bold;">@_resumenDirectosCapital.ToString("N2")</MudText></td>
                                </tr>
                                <tr>
                                    <td><MudText Typo="Typo.body2">Intereses</MudText></td>
                                    <td style="text-align:right;"><MudText Typo="Typo.body2" Style="font-weight:bold;">@_resumenDirectosIntereses.ToString("N2")</MudText></td>
                                </tr>
                                <tr style="border-top: 1px solid var(--mud-palette-lines-default);">
                                    <td><MudText Typo="Typo.body2" Style="font-weight:bold;">Total Directos</MudText></td>
                                    <td style="text-align:right;"><MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-weight:bold;">@_resumenDirectosTotal.ToString("N2")</MudText></td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                        <MudDivider Class="mb-2" />
                    }

                    @* ── Sección 2: Préstamo de Nómina (requiere amortización calculada) ── *@
                    @if (_preview is not null && _nominaActiva)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:bold; text-transform:uppercase; letter-spacing:0.5px;">
                            Préstamo Nómina
                        </MudText>
                        <MudSimpleTable Dense="true" Bordered="false" Style="border:none; margin-bottom:4px;">
                            <tbody>
                                <tr>
                                    <td><MudText Typo="Typo.body2">Capital Amortizable</MudText></td>
                                    <td style="text-align:right;"><MudText Typo="Typo.body2" Style="font-weight:bold;">@_preview.CapitalAmortizable.ToString("N2")</MudText></td>
                                </tr>
                                <tr>
                                    <td><MudText Typo="Typo.body2">Total de Intereses</MudText></td>
                                    <td style="text-align:right;"><MudText Typo="Typo.body2" Style="font-weight:bold;">@_preview.TotalIntereses.ToString("N2")</MudText></td>
                                </tr>
                                <tr style="border-top: 1px solid var(--mud-palette-lines-default);">
                                    <td><MudText Typo="Typo.body2" Style="font-weight:bold;">Total Nómina</MudText></td>
                                    <td style="text-align:right;"><MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-weight:bold;">@_preview.TotalPagar.ToString("N2")</MudText></td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                        <MudDivider Class="mb-2" />
                    }

                    @* ── Sección 3: Total General ── *@
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:bold; text-transform:uppercase; letter-spacing:0.5px;">
                        Total General de la Solicitud
                    </MudText>
                    <MudSimpleTable Dense="true" Bordered="false" Style="border:none; margin-bottom:4px;">
                        <tbody>
                            @if (_prestamosDirectos.Count > 0)
                            {
                                <tr>
                                    <td><MudText Typo="Typo.body2">Préstamos Directos</MudText></td>
                                    <td style="text-align:right;"><MudText Typo="Typo.body2" Style="font-weight:bold;">@_resumenDirectosTotal.ToString("N2")</MudText></td>
                                </tr>
                            }
                            @if (_preview is not null && _nominaActiva)
                            {
                                <tr>
                                    <td><MudText Typo="Typo.body2">Préstamo Nómina</MudText></td>
                                    <td style="text-align:right;"><MudText Typo="Typo.body2" Style="font-weight:bold;">@_resumenNominaTotal.ToString("N2")</MudText></td>
                                </tr>
                            }
                            <tr style="border-top: 2px solid var(--mud-palette-primary);">
                                <td><MudText Typo="Typo.body1" Style="font-weight:bold;">Gran Total</MudText></td>
                                <td style="text-align:right;"><MudText Typo="Typo.body1" Color="Color.Primary" Style="font-weight:bold;">@_resumenGranTotal.ToString("N2")</MudText></td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                    <MudDivider Class="mb-2" />
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── Sección: Préstamos Directos (ancho completo, layout horizontal) ── *@
    <MudPaper Elevation="1" Class="pa-4 mt-1" Style="border-radius: 0;">
        <div class="d-flex align-center justify-space-between mb-3" Style="border-bottom: 2px solid var(--mud-palette-primary); padding-bottom: 4px;">
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight: bold;">
                <MudIcon Icon="@Icons.Material.Filled.AddCard" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                Préstamos Directos
            </MudText>
            <div class="d-flex align-center gap-4">
                @if (_prestamosDirectos.Count > 0)
                {
                    var _totalMonto     = _prestamosDirectos.Sum(p => p.MontoSolicitado);
                    var _totalIntereses = _prestamosDirectos.Sum(p =>
                        Math.Round(p.MontoSolicitado * (p.TasaMensual / 100m) * (p.DiazPlazo / 30m), 2));
                    var _totalGeneral   = _totalMonto + _totalIntereses;
                    <div class="d-flex align-center gap-4">
                        <MudText Typo="Typo.body2">
                            Capital: <span style="color: var(--mud-palette-primary); font-weight: bold;">@_totalMonto.ToString("C2")</span>
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Intereses: <span style="color: var(--mud-palette-warning); font-weight: bold;">@_totalIntereses.ToString("C2")</span>
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Total: <span style="color: var(--mud-palette-success); font-weight: bold;">@_totalGeneral.ToString("C2")</span>
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Calculate" OnClick="SimularAmortizacion">
                        Recalcular
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarPrestamoDirecto">
                    Préstamo Directo
                </MudButton>
            </div>
        </div>

        @if (_prestamosDirectos.Count == 0)
        {
            <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Dense="true">
                No hay préstamos directos. Haga clic en <b>Agregar Préstamo Directo</b> para incluir uno.
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="1">
                @foreach (var (prestamo, idx) in _prestamosDirectos.Select((p, i) => (p, i)))
                {
                    <div class="d-flex align-center gap-2" Style="border-bottom: 1px solid var(--mud-palette-primary); padding-bottom: 1px;">
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="@($"#{idx + 1} Descripción")" @bind-Value="prestamo.Descripcion"
                                      Margin="Margin.Dense" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudNumericField T="decimal" Label="Monto Solicitado" @bind-Value="prestamo.MontoSolicitado"
                                         Format="N2" Min="1m" Step="1000" Margin="Margin.Dense"
                                         Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="$" />
                    </MudItem>
                    <MudItem xs="6" md="1">
                        <MudNumericField T="decimal" Label="Tasa Mensual %" @bind-Value="prestamo.TasaMensual"
                                         Format="N2" Min="0.01m" Step="0.5m" Margin="Margin.Dense"
                                         Variant="Variant.Outlined"
                                         ReadOnly="@EsCajaDeAhorro" />
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudDatePicker Label="Fecha de Pago" Date="@prestamo.FechaPago"
                                       DateChanged="@((DateTime? d) => OnFechaPagoDirectoChanged(prestamo, d))"
                                       Margin="Margin.Dense" Variant="Variant.Outlined" Editable="true"
                                       MaxDate="@(EsCajaDeAhorro ? FechaCierreDirectoEfectiva : null)"/>
                    </MudItem>
                    <MudItem xs="6" md="1">
                        <MudNumericField T="int" Label="Días Plazo" Value="@prestamo.DiazPlazo"
                                         ReadOnly="true" Margin="Margin.Dense"
                                         Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6" md="2">
                        @{
                            var intPD = Math.Round(prestamo.MontoSolicitado * (prestamo.TasaMensual/100) * (prestamo.DiazPlazo / 30m), 2);
                            var totalPD = prestamo.MontoSolicitado + intPD;
                        }
                        <MudPaper Elevation="0" Class="pa-0" Style="background: var(--mud-palette-background-grey); border-radius: 4px; height: 100%;">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Intereses: <b>@intPD.ToString("C2")</b></MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight: bold;">Total: @totalPD.ToString("C2")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="1" Class="d-flex align-content-lg-end">
                        <MudTooltip Text="Eliminar préstamo directo">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" 
                                           Size="Size.Medium"
                                           OnClick="@(() => EliminarPrestamoDirecto(idx))" />
                        </MudTooltip>
                    </MudItem>
                    </div>
                }
            </MudGrid>
        }
    </MudPaper>


</MudForm>

