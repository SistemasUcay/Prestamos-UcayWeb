@* ── Diálogo: Confirmar Guardado ── *@
<MudDialog @bind-Visible="_confirmarGuardadoVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" Style="vertical-align: middle;" />
            Confirmar Solicitud
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-4">
            ¿Está seguro de registrar la solicitud con los siguientes datos?
        </MudAlert>

        @* ── Préstamo Nómina ── *@
        @if (_nominaActiva)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:bold; text-transform:uppercase; letter-spacing:0.5px;" Class="mb-1">
                Préstamo Nómina
            </MudText>
            <MudSimpleTable Dense="true" Class="mb-3">
                <tbody>
                    <tr><td>Empleado</td><td><b>@(_empleadoSeleccionado?.NombreCompleto ?? "—")</b></td></tr>
                    <tr><td>Monto</td><td><b>@_model.MontoAprobado.ToString("C2")</b></td></tr>
                    <tr><td>Plazo</td><td><b>@_model.PlazoMeses meses</b></td></tr>
                    <tr><td>Tasa Mensual</td><td><b>@_tasaMensual.ToString("N2")%</b></td></tr>
                    <tr><td>Cuota por Período</td><td><b>@(_preview?.CuotaMensual.ToString("C2") ?? "—")</b></td></tr>
                    <tr><td>Número de Pagos</td><td><b>@(_preview?.NumeroPagos.ToString() ?? "—")</b></td></tr>
                    <tr><td>Total a Pagar</td><td><b>@(_preview?.TotalPagar.ToString("C2") ?? "—")</b></td></tr>
                </tbody>
            </MudSimpleTable>
        }

        @* ── Préstamos Directos ── *@
        @if (_prestamosDirectos.Count > 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:bold; text-transform:uppercase; letter-spacing:0.5px;" Class="mb-1">
                Préstamos Directos
            </MudText>
            <MudSimpleTable Dense="true" Class="mb-3">
                <thead>
                    <tr>
                        <th>Descripción</th>
                        <th style="text-align:right;">Monto</th>
                        <th style="text-align:right;">Tasa %</th>
                        <th style="text-align:right;">Fecha Pago</th>
                        <th style="text-align:right;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pd in _prestamosDirectos)
                    {
                        var intPD   = Math.Round(pd.MontoSolicitado * (pd.TasaMensual / 100m) * (pd.DiazPlazo / 30m), 2);
                        var totalPD = pd.MontoSolicitado + intPD;
                        <tr>
                            <td>@pd.Descripcion</td>
                            <td style="text-align:right;"><b>@pd.MontoSolicitado.ToString("C2")</b></td>
                            <td style="text-align:right;">@pd.TasaMensual.ToString("N2")%</td>
                            <td style="text-align:right;">@pd.FechaPago.ToString("dd/MM/yyyy")</td>
                            <td style="text-align:right;"><b>@totalPD.ToString("C2")</b></td>
                        </tr>
                    }
                    <tr style="border-top: 2px solid var(--mud-palette-primary);">
                        <td colspan="4"><b>Total Directos</b></td>
                        <td style="text-align:right;"><b>@(_prestamosDirectos.Sum(p => p.MontoSolicitado + Math.Round(p.MontoSolicitado * (p.TasaMensual / 100m) * (p.DiazPlazo / 30m), 2)).ToString("C2"))</b></td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        }

        @{
            var capitalNominaResumen = _nominaActiva ? _model.MontoAprobado : 0m;
            var interesNominaResumen = (_nominaActiva && _preview is not null) ? _preview.TotalIntereses : 0m;
            var totalNominaResumen = capitalNominaResumen + interesNominaResumen;

            var capitalDirectosResumen = _prestamosDirectos.Sum(p => p.MontoSolicitado);
            var interesDirectosResumen = _prestamosDirectos.Sum(p => Math.Round(p.MontoSolicitado * (p.TasaMensual / 100m) * (p.DiazPlazo / 30m), 2));
            var totalDirectosResumen = capitalDirectosResumen + interesDirectosResumen;

            var capitalGeneralResumen = capitalNominaResumen + capitalDirectosResumen;
            var interesesGeneralResumen = interesNominaResumen + interesDirectosResumen;
            var totalGeneralResumen = totalNominaResumen + totalDirectosResumen;
        }

        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:bold; text-transform:uppercase; letter-spacing:0.5px;" Class="mb-1">
            Resumen General (Capital + Intereses)
        </MudText>
        <MudSimpleTable Dense="true">
            <thead>
                <tr>
                    <th>Concepto</th>
                    <th style="text-align:right;">Capital</th>
                    <th style="text-align:right;">Intereses</th>
                    <th style="text-align:right;">Total</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Préstamo Nómina</td>
                    <td style="text-align:right;"><b>@capitalNominaResumen.ToString("C2")</b></td>
                    <td style="text-align:right;"><b>@interesNominaResumen.ToString("C2")</b></td>
                    <td style="text-align:right;"><b>@totalNominaResumen.ToString("C2")</b></td>
                </tr>
                <tr>
                    <td>Préstamos Directos</td>
                    <td style="text-align:right;"><b>@capitalDirectosResumen.ToString("C2")</b></td>
                    <td style="text-align:right;"><b>@interesDirectosResumen.ToString("C2")</b></td>
                    <td style="text-align:right;"><b>@totalDirectosResumen.ToString("C2")</b></td>
                </tr>
                <tr style="border-top: 2px solid var(--mud-palette-primary);">
                    <td><b>Total General</b></td>
                    <td style="text-align:right;"><b>@capitalGeneralResumen.ToString("C2")</b></td>
                    <td style="text-align:right;"><b>@interesesGeneralResumen.ToString("C2")</b></td>
                    <td style="text-align:right;"><b>@totalGeneralResumen.ToString("C2")</b></td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _confirmarGuardadoVisible = false)" Variant="Variant.Text">Cancelar</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="EjecutarGuardar"
                   Disabled="@_saving" StartIcon="@(_saving ? null : Icons.Material.Filled.Save)">
            @if (_saving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Guardando...</MudText>
            }
            else
            {
                <MudText>Confirmar y Guardar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code 
{
    [Parameter] public int? PrestamoEditId { get; set; }

    // ── Modelo ──
    private PrestamoCreateDto _model = new()
    {
        DestinoCredito = string.Empty,
        FechaEntrega = DateTime.Today,
        PlazoMeses = 1,
        MontoAprobado = 0
    };

    private decimal _tasaMensual = 5;
    private DateTime? _fechaSolicitud = DateTime.Today;
    private DateTime? _fechaEntrega = DateTime.Today;
    // Única fuente de verdad para la fecha final de descuento / vencimiento.
    private DateTime? _fechaFinalDescuento;
    private int _prestamoId;

    // ── Catálogos ──
    private List<EmpresaListDto> _fondeadoras = [];
    private List<TipoPrestamoDto> _tiposPrestamo = [];
    private List<TipoPagoDto> _tiposPago = [];
    private ParametrosDto _parametros = new();
    private ParametrosDto? _parametrosProximoAnio;
    // private int _condicionCreditoId;

    /// <summary>
    /// Fecha de cierre de caja de ahorro vigente según la fecha de entrega:
    /// - Si la fecha de entrega es anterior o igual al cierre del año actual → CierreCajaAnual del año actual.
    /// - Si es posterior al cierre del año actual → CierreCajaAnual del año siguiente (requiere que esté capturado).
    /// Retorna null cuando aún no hay datos suficientes.
    /// </summary>
    private DateTime? FechaCierreCajaEfectiva
    {
        get
        {
            if (!EsCajaDeAhorro) return null;

            DateTime entrega = _fechaEntrega ?? DateTime.Today;
            DateTime? cierreActual = _parametros.CierreCajaAnual;

            if (cierreActual.HasValue && entrega <= cierreActual.Value)
                return cierreActual;

            // El préstamo es posterior al cierre actual → usar el del año siguiente
            return _parametrosProximoAnio?.CierreCajaAnual;
        }
    }

    /// <summary>
    /// Fecha máxima permitida para los Préstamos Directos de Caja de Ahorro.
    /// Es el último día del mes en que cae el cierre de caja, lo que permite
    /// que los directos venzan hasta el fin de ese mes (a diferencia de los
    /// préstamos nómina que se limitan al día exacto del cierre).
    /// Ejemplo: cierre 23-oct-2026 → máximo directo 31-oct-2026.
    /// </summary>
    private DateTime? FechaCierreDirectoEfectiva
    {
        get
        {
            DateTime? cierre = FechaCierreCajaEfectiva;
            if (cierre is null) return null;
            return new DateTime(cierre.Value.Year, cierre.Value.Month,
                DateTime.DaysInMonth(cierre.Value.Year, cierre.Value.Month));
        }
    }

    // ── Empleado ──
    private int _empleadoIdBuscar;
    private EmpleadoDetailDto? _empleadoSeleccionado;
    private bool _buscarEmpleadoVisible;
    private string _busquedaEmpleadoTexto = "";
    private List<EmpleadoListDto> _todosEmpleados = [];
    private MudTable<EmpleadoListDto> _tablaEmpleados = null!;

    private IEnumerable<EmpleadoListDto> _empleadosFiltrados =>
        string.IsNullOrWhiteSpace(_busquedaEmpleadoTexto)
            ? _todosEmpleados
            : _todosEmpleados.Where(e =>
                e.NombreCompleto.Contains(_busquedaEmpleadoTexto, StringComparison.OrdinalIgnoreCase) ||
                e.Rfc.Contains(_busquedaEmpleadoTexto, StringComparison.OrdinalIgnoreCase) ||
                e.NumeroNomina.ToString().Contains(_busquedaEmpleadoTexto));

    // ── Preview ──
    private AmortizacionPreviewResultDto? _preview;
    private bool _simulando;
    // Evita que los callbacks ValueChanged/DateChanged re-disparen la simulación
    // cuando la propia simulación actualiza _fechaFinalDescuento y _model.PlazoMeses.
    private bool _actualizandoDesdeSimulacion;

    // ── Préstamos Directos ──
    private List<PrestamoDirectoCreateDto> _prestamosDirectos = [];

    // ── Modalidades ──
    /// <summary>Indica si el Préstamo Nómina está incluido en la solicitud. Solo puede desactivarse cuando la fondeadora es Caja de Ahorro.</summary>
    private bool _nominaActiva = true;

    // ── Form ──
    private MudForm _form = null!;
    private bool _formValid;
    private bool _saving;
    private bool _confirmarGuardadoVisible;
    private bool _confirmarSalidaVisible;
    private string _pendingNavigationUrl = string.Empty;
    private IDisposable? _locationChangingRegistration;

    private bool PuedeSimular => 
        _nominaActiva &&
        _model.FondeadoraId > 0 && 
        _model.EmpleadoId > 0 && 
        (EsCajaDeAhorro || _model.TipoPrestamoId > 0) && 
        _model.MontoAprobado > 0 && 
        _model.PlazoMeses > 0 && 
        _tasaMensual > 0;

    private bool EsCajaDeAhorro => 
        _fondeadoras.FirstOrDefault(f => f.NumEmpresa == _model.FondeadoraId)?.IsCajaDeAhorro ?? false;

    private ClasificacionTipoPrestamo? ClasificacionSeleccionada =>
        _tiposPrestamo.FirstOrDefault(tp => tp.TipoPrestamoId == _model.TipoPrestamoId)?.Clasificacion;

    private int PlazoMinimo => ClasificacionSeleccionada switch
    {
        ClasificacionTipoPrestamo.LargoPlazo       => 13,
        ClasificacionTipoPrestamo.PrestamoHipotecario => 13,
        _                                          => 1
    };

    private int PlazoMaximo => ClasificacionSeleccionada switch
    {
        ClasificacionTipoPrestamo.CortoPlazo => 12,
        _                                    => 360
    };

    private string? HelperTextPlazo => ClasificacionSeleccionada switch
    {
        ClasificacionTipoPrestamo.CortoPlazo          => "Máx. 12 meses (Corto Plazo)",
        ClasificacionTipoPrestamo.LargoPlazo          => "Mín. 13 meses (Largo Plazo)",
        ClasificacionTipoPrestamo.PrestamoHipotecario => "Mín. 13 meses (Hipotecario)",
        _                                             => null
    };

    /// <summary>
    /// Tasa mensual que aplica a los Préstamos Directos según los parámetros generales.
    /// - Caja de Ahorro: usa TasaFijaDirecto si está configurada, si no _tasaMensual.
    /// - Empresa (no Caja): usa la misma TasaFijaEmpresa que la nómina (_tasaMensual).
    /// </summary>
    private decimal TasaDirectoEfectiva =>
        EsCajaDeAhorro
            ? _parametros.TasaFijaDirecto ?? _tasaMensual
            : _tasaMensual;

    private string? ValidarPlazo(int valor)
    {
        if (EsCajaDeAhorro) return null;
        return ClasificacionSeleccionada switch
        {
            ClasificacionTipoPrestamo.CortoPlazo when valor > 12
                => "Corto Plazo no puede exceder 12 meses.",
            ClasificacionTipoPrestamo.LargoPlazo when valor <= 12
                => "Largo Plazo debe ser mayor a 12 meses.",
            ClasificacionTipoPrestamo.PrestamoHipotecario when valor <= 12
                => "Préstamo Hipotecario debe ser mayor a 12 meses.",
            _ => null
        };
    }

    private decimal TotalSolicitud =>
        (_nominaActiva ? _model.MontoAprobado : 0m) + _prestamosDirectos.Sum(p => p.MontoSolicitado);

    private bool FormularioModificado =>
        _model.FondeadoraId > 0 ||
        _model.EmpleadoId > 0 ||
        (_nominaActiva && _model.MontoAprobado > 0) ||
        !string.IsNullOrWhiteSpace(_model.DestinoCredito) ||
        _prestamosDirectos.Count > 0 ||
        !_nominaActiva;

    protected override async Task OnInitializedAsync()
    {
        _locationChangingRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChanging);
        try
        {
            var empresasTask = EmpresasApi.GetEmpresasAsync();
            var tiposPrestamoTask = CatalogosApi.GetTiposPrestamoAsync();
            var tiposPagoTask = CatalogosApi.GetTiposPagoAsync();
            var empleadosTask = EmpleadosApi.GetEmpleadosAsync();
            var parametrosTask = ParametrosApi.GetParametrosAsync(DateTime.Today.Year);

            await Task.WhenAll(empresasTask, tiposPrestamoTask, tiposPagoTask, empleadosTask, parametrosTask);

            _fondeadoras = empresasTask.Result;
            _tiposPrestamo = tiposPrestamoTask.Result;
            _tiposPago = tiposPagoTask.Result;
            _todosEmpleados = empleadosTask.Result;
            _parametros = parametrosTask.Result;

            if (_tiposPago.Count > 0)
                _model.TipoPagoId = _tiposPago[0].TipoPagoId;

            var cortoPlazo = _tiposPrestamo.FirstOrDefault(tp => tp.Clasificacion == ClasificacionTipoPrestamo.CortoPlazo);
            if (cortoPlazo is not null)
                _model.TipoPrestamoId = cortoPlazo.TipoPrestamoId;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar catálogos: {ex.Message}", Severity.Error);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PrestamoEditId.HasValue && PrestamoEditId.Value > 0)
        {
            await CargarPrestamoParaEdicion(PrestamoEditId.Value);
        }
    }

    private async Task CargarPrestamoParaEdicion(int prestamoId)
    {
        try
        {
            var detalle = await PrestamosApi.GetByIdAsync(prestamoId);
            if (detalle == null)
            {
                Snackbar.Add($"No se encontró el préstamo con ID {prestamoId}", Severity.Warning);
                return;
            }

            _prestamoId = detalle.Id;
            _fechaSolicitud = detalle.FechaSolicitud;
            _fechaEntrega = detalle.FechaDeposito ?? detalle.FechaAprobado;
            _model.FechaEntrega = _fechaEntrega ?? DateTime.Today;
            _model.MontoAprobado = detalle.MontoAprobado;
            _model.PlazoMeses = detalle.PlazoMeses;
            _model.DestinoCredito = detalle.DestinoCredito;
            _tasaMensual = detalle.TasaInteresMensual;
            _model.TasaInteresMensual = detalle.TasaInteresMensual;
            _fechaFinalDescuento = detalle.FinalDescuento;

            // Asignar IDs directamente desde el detalle
            _model.EmpleadoId = detalle.EmpleadoId;
            _model.FondeadoraId = detalle.FuenteFondeoId;
            _model.TipoPrestamoId = detalle.TipoPrestamoId;
            _model.TipoPagoId = detalle.TipoPagoId;

            // Cargar empleado para mostrar su información
            _empleadoIdBuscar = detalle.EmpleadoId;
            await CargarEmpleadoPorId(detalle.EmpleadoId);

            // Cargar préstamos directos existentes ordenados por fecha de pago
            if (detalle.PrestamosDirectos?.Count > 0)
            {
                _prestamosDirectos = detalle.PrestamosDirectos
                    .Select(pd => new PrestamoDirectoCreateDto
                    {
                        Descripcion = pd.Descripcion,
                        MontoSolicitado = pd.MontoSolicitado,
                        TasaMensual = pd.TasaMensual,
                        FechaPago = pd.FechaPago,
                        DiazPlazo = pd.DiazPlazo
                    })
                    .OrderBy(pd => pd.FechaPago)
                    .ToList();
            }

            // Crear el preview con la tabla de amortización completa
            _preview = new AmortizacionPreviewResultDto
            {
                CapitalAmortizable = detalle.MontoAprobado,
                TotalIntereses = detalle.TablaAmortizacion?.Sum(a => a.ImporteInteres) ?? 0,
                TotalPagar = detalle.TotalPagar,
                CuotaMensual = detalle.ImporteCuotas,
                TasaPorPeriodo = detalle.TasaInteresMensual,
                NumeroPagos = detalle.NumeroCuotas,
                FechaUltimoPago = detalle.FinalDescuento,
                DiasPlayzo = (detalle.FinalDescuento - detalle.InicioDescuento).Days,
                PagosAdicionalesCapital = 0,
                TablaAmortizacion = detalle.TablaAmortizacion ?? [],
                PrestamosDirectos = detalle.PrestamosDirectos?.Select(pd => new PrestamoDirectoDto
                {
                    NumPrestamoDirecto = pd.NumPrestamoDirecto,
                    PrestamoId = pd.PrestamoId,
                    Descripcion = pd.Descripcion,
                    MontoSolicitado = pd.MontoSolicitado,
                    TasaMensual = pd.TasaMensual,
                    FechaPago = pd.FechaPago,
                    DiazPlazo = pd.DiazPlazo,
                    MontoIntereses = pd.MontoIntereses,
                    TotalCapitalInteres = pd.TotalCapitalInteres
                }).ToList() ?? []
            };

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar el préstamo: {ex.Message}", Severity.Error);
        }
    }

