@page "/gestion-tipos-prestamo"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador,Supervisor,RecursosHumanos")]
@inject CatalogosApiService CatalogosApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@using PrestamosUcayNet.Domain.Enums

<PageTitle>Gestión de Tipos de Préstamo — Préstamos UcayNet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">
    <MudIcon Icon="@Icons.Material.Filled.Category" Class="mr-2" Style="vertical-align: middle;" />
    Gestión de Tipos de Préstamo
</MudText>
<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-4">
    Administra los tipos de préstamo y su clasificación
</MudText>

@* Barra de búsqueda y botón Nuevo *@
<MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-radius: 12px;">
    <MudGrid Spacing="2" Justify="Justify.SpaceBetween" Class="align-center">
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_searchString" Placeholder="Buscar por nombre, clasificación o ID..."
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add"
                OnClick="() => AbrirFormulario()"
                Style="border-radius: 8px; text-transform: none;">
                Nuevo Tipo de Préstamo
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* Tabla de datos *@
<MudPaper Elevation="2" Class="pa-4" Style="border-radius: 12px;">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    <MudDataGrid T="TipoPrestamoDto" Items="@_tiposPrestamo" Dense="true"
        Hover="true" Striped="true" Bordered="false"
        QuickFilter="@_quickFilter"
        Style="border-radius: 8px;"
        RowsPerPage="15">
        <Columns>
            <PropertyColumn Property="x => x.TipoPrestamoId" Title="ID" CellStyle="width: 80px;" />
            <PropertyColumn Property="x => x.Descripcion" Title="Tipo de Préstamo" />
            <TemplateColumn Title="Clasificación">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small"
                        Color="@ObtenerColorClasificacion(context.Item.Clasificacion)"
                        Variant="Variant.Filled">
                        @ObtenerTextoClasificacion(context.Item.Clasificacion)
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Préstamos" CellStyle="width: 120px;">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small"
                        Color="@(context.Item.CantidadPrestamos > 0 ? Color.Info : Color.Default)"
                        Variant="Variant.Outlined">
                        @context.Item.CantidadPrestamos
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" CellStyle="width: 120px;">
                <CellTemplate>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small"
                            OnClick="@(() => AbrirFormulario(context.Item))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                            Disabled="@(context.Item.CantidadPrestamos > 0)"
                            OnClick="@(() => ConfirmarEliminacion(context.Item))" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-4">
                No se encontraron tipos de préstamo.
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="TipoPrestamoDto" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>

@* Diálogo de Formulario *@
<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(_model.TipoPrestamoId == 0 ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)"
                Class="mr-2" Style="vertical-align: middle;" />
            @(_model.TipoPrestamoId == 0 ? "Nuevo Tipo de Préstamo" : "Editar Tipo de Préstamo")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudTextField T="string" Label="Descripción" @bind-Value="_model.Descripcion"
                Required="true" RequiredError="La descripción es obligatoria"
                Counter="100" MaxLength="100"
                Validation="@(new Func<string, string?>(ValidarDescripcion))"
                Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4"
                Immediate="true"
                Disabled="@_saving" />

            <MudSelect T="ClasificacionTipoPrestamo" Label="Clasificación" @bind-Value="_model.Clasificacion"
                Required="true" RequiredError="La clasificación es obligatoria"
                Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4"
                Disabled="@_saving">
                <MudSelectItem T="ClasificacionTipoPrestamo" Value="ClasificacionTipoPrestamo.CortoPlazo">Corto Plazo</MudSelectItem>
                <MudSelectItem T="ClasificacionTipoPrestamo" Value="ClasificacionTipoPrestamo.LargoPlazo">Largo Plazo</MudSelectItem>
                <MudSelectItem T="ClasificacionTipoPrestamo" Value="ClasificacionTipoPrestamo.PrestamoHipotecario">Préstamo Hipotecario</MudSelectItem>
                <MudSelectItem T="ClasificacionTipoPrestamo" Value="ClasificacionTipoPrestamo.PrestamoDirecto">Préstamo Directo</MudSelectItem>
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogVisible = false" Disabled="@_saving">Cancelar</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync"
            Disabled="@(!_formIsValid || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Guardando...</span>
            }
            else
            {
                <span>Guardar</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<TipoPrestamoDto> _tiposPrestamo = new();
    private bool _loading = true;
    private bool _saving;
    private string _searchString = "";
    private bool _dialogVisible;
    private bool _formIsValid;
    private MudForm _form = null!;
    private TipoPrestamoDto _model = new();
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    protected override async Task OnInitializedAsync()
    {
        await CargarTiposPrestamoAsync();
    }

    private async Task CargarTiposPrestamoAsync()
    {
        _loading = true;
        try
        {
            _tiposPrestamo = await CatalogosApi.GetTiposPrestamoAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar tipos de préstamo: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Func<TipoPrestamoDto, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (x.Descripcion.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if ($"{x.TipoPrestamoId}".Contains(_searchString)) return true;
        if (ObtenerTextoClasificacion(x.Clasificacion).Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    };

    private static string ObtenerTextoClasificacion(ClasificacionTipoPrestamo clasificacion) => clasificacion switch
    {
        ClasificacionTipoPrestamo.CortoPlazo => "Corto Plazo",
        ClasificacionTipoPrestamo.LargoPlazo => "Largo Plazo",
        ClasificacionTipoPrestamo.PrestamoHipotecario => "Préstamo Hipotecario",
        ClasificacionTipoPrestamo.PrestamoDirecto => "Préstamo Directo",
        _ => "Desconocido"
    };

    private static Color ObtenerColorClasificacion(ClasificacionTipoPrestamo clasificacion) => clasificacion switch
    {
        ClasificacionTipoPrestamo.CortoPlazo => Color.Success,
        ClasificacionTipoPrestamo.LargoPlazo => Color.Info,
        ClasificacionTipoPrestamo.PrestamoHipotecario => Color.Warning,
        ClasificacionTipoPrestamo.PrestamoDirecto => Color.Primary,
        _ => Color.Default
    };

    private static string? ValidarDescripcion(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return "La descripción es obligatoria.";
        if (valor.Length < 3)
            return "Debe tener al menos 3 caracteres.";
        return null;
    }

    private void AbrirFormulario(TipoPrestamoDto? item = null)
    {
        _model = item is null
            ? new TipoPrestamoDto { Clasificacion = ClasificacionTipoPrestamo.CortoPlazo }
            : new TipoPrestamoDto
            {
                TipoPrestamoId = item.TipoPrestamoId,
                Descripcion = item.Descripcion,
                Clasificacion = item.Clasificacion
            };
        _dialogVisible = true;
    }

    private async Task GuardarAsync()
    {
        await _form.ValidateAsync();
        if (!_formIsValid) return;

        _saving = true;
        try
        {
            bool esNuevo = _model.TipoPrestamoId == 0;
            bool success = esNuevo
                ? await CatalogosApi.CreateTipoPrestamoAsync(_model)
                : await CatalogosApi.UpdateTipoPrestamoAsync(_model);

            if (success)
            {
                Snackbar.Add(esNuevo ? "Tipo de préstamo creado correctamente." : "Tipo de préstamo actualizado correctamente.", Severity.Success);
                _dialogVisible = false;
                await CargarTiposPrestamoAsync();
            }
            else
            {
                Snackbar.Add("No se pudo guardar. Verifique que la descripción no esté duplicada.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmarEliminacion(TipoPrestamoDto item)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirmar Eliminación",
            $"¿Está seguro de eliminar el tipo de préstamo '{item.Descripcion}'?",
            yesText: "Eliminar", cancelText: "Cancelar"
        );

        if (result != true) return;

        try
        {
            var success = await CatalogosApi.DeleteTipoPrestamoAsync(item.TipoPrestamoId);
            if (success)
            {
                Snackbar.Add("Tipo de préstamo eliminado correctamente.", Severity.Success);
                await CargarTiposPrestamoAsync();
            }
            else
            {
                Snackbar.Add("No se pudo eliminar. Verifique que no tenga préstamos asociados.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }
}
