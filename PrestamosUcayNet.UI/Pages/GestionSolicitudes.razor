@page "/gestion-solicitudes"
@using Microsoft.AspNetCore.Authorization
@using PrestamosUcayNet.Application.DTOs
@using PrestamosUcayNet.UI.Services
@using MudBlazor
@attribute [Authorize(Roles = "Administrador,Gerente")]
@inject PrestamosApiService PrestamosApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <div class="d-flex align-center justify-space-between mb-6">
        <MudText Typo="Typo.h4" GutterBottom="true">Gestión de Solicitudes de Préstamo</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("/captura-prestamo"))">
            Nueva Solicitud
        </MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
    else
    {
        <MudDataGrid Items="@_prestamos" Filterable="true" SortMode="SortMode.Multiple" Hover="true" Bordered="true" Striped="true">
            <Columns>
                <PropertyColumn Property="x => x.FechaSolicitud" Title="Fecha" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.NombreEmpleado" Title="Empleado" />
                <PropertyColumn Property="x => x.NombreFondeadora" Title="Fondeadora" />
                <PropertyColumn Property="x => x.TipoPrestamoDescripcion" Title="Tipo Préstamo" />
                <PropertyColumn Property="x => x.MontoAprobado" Title="Monto" Format="C2" />
                <PropertyColumn Property="x => x.PlazoMeses" Title="Plazo (Meses)" />
                <TemplateColumn Title="Estado" CellStyle="width: 130px;">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@ObtenerColorEstadoPrestamo(context.Item.Estado)">
                            @ObtenerDescripcionEstado(context.Item.Estado)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Acciones" CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary" OnClick="@(() => AbrirRevision(context.Item))">Revisar</MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="PrestamoListDto" />
            </PagerContent>
        </MudDataGrid>
    }
</MudContainer>

<MudDialog @bind-IsVisible="_revisionVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Revisión de Préstamo #@_selectedPrestamo?.PrestamoId</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedPrestamo != null)
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Empleado</MudText>
                    <MudText Typo="Typo.body1">@_selectedPrestamo.NombreEmpleado</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Fondeadora</MudText>
                    <MudText Typo="Typo.body1">@_selectedPrestamo.NombreFondeadora</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Monto Aprobado</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">@_selectedPrestamo.MontoAprobado.ToString("C2")</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Plazo</MudText>
                    <MudText Typo="Typo.body1">@_selectedPrestamo.PlazoMeses meses</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Tipo de Préstamo</MudText>
                    <MudText Typo="Typo.body1">@_selectedPrestamo.TipoPrestamoDescripcion</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Tipo de Pago</MudText>
                    <MudText Typo="Typo.body1">@_selectedPrestamo.TipoPagoDescripcion</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-4" />
                    <MudTextField T="string" Label="Notas / Motivo (Requerido para rechazo/cancelación)" 
                                  @bind-Value="_notasRevision" Lines="3" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => _revisionVisible = false">Cerrar</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Rechazar"
                   StartIcon="@Icons.Material.Filled.ThumbDown">Rechazar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="Cancelar"
                   StartIcon="@Icons.Material.Filled.Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AprobarYEntregar"
                   StartIcon="@Icons.Material.Filled.CheckCircle">Aprobar y Entregar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<PrestamoListDto> _prestamos = new();
    private bool _loading = true;
    private bool _revisionVisible = false;
    private PrestamoListDto? _selectedPrestamo;
    private string _notasRevision = "";
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await CargarPrestamos();
    }

    private async Task CargarPrestamos()
    {
        _loading = true;
        try
        {
            // Cargar préstamos no evaluados (estado "E" o según el estado que definas)
            // Por ahora asumimos estado "E" = En Evaluación
            _prestamos = await PrestamosApi.GetPorEstadoAsync("E");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar préstamos pendientes: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void AbrirRevision(PrestamoListDto item)
    {
        _selectedPrestamo = item;
        _notasRevision = "";
        _revisionVisible = true;
    }

    private async Task AprobarYEntregar()
    {
        if (_selectedPrestamo == null) return;

        var activarDto = new ActivarPrestamoDto 
        { 
            PrestamoId = _selectedPrestamo.PrestamoId,
            FechaEntrega = DateTime.Now,
            MetodoEntrega = "Transferencia",
            Referencia = _notasRevision ?? "Aprobado",
            Folio = null
        };

        var result = await PrestamosApi.ActivarAsync(activarDto);

        if (result)
        {
            Snackbar.Add("Préstamo aprobado y entregado. Ahora está activo.", Severity.Success);
            _revisionVisible = false;
            await CargarPrestamos();
        }
        else
        {
            Snackbar.Add("No se pudo activar el préstamo.", Severity.Error);
        }
    }

    private async Task Rechazar()
    {
        if (_selectedPrestamo == null) return;
        if (string.IsNullOrWhiteSpace(_notasRevision))
        {
            Snackbar.Add("Debe indicar el motivo del rechazo.", Severity.Warning);
            return;
        }

        // Para rechazar, cambiaríamos el estado a "R" (Rechazado)
        // Necesitamos un método en el API para esto, por ahora usamos Cancelar con estado específico
        var result = await PrestamosApi.CancelarAsync(_selectedPrestamo.PrestamoId);

        if (result)
        {
            Snackbar.Add("Préstamo rechazado.", Severity.Info);
            _revisionVisible = false;
            await CargarPrestamos();
        }
        else
        {
            Snackbar.Add("No se pudo rechazar el préstamo.", Severity.Error);
        }
    }

    private async Task Cancelar()
    {
        if (_selectedPrestamo == null) return;
        if (string.IsNullOrWhiteSpace(_notasRevision))
        {
            Snackbar.Add("Debe indicar el motivo de la cancelación.", Severity.Warning);
            return;
        }

        var result = await PrestamosApi.CancelarAsync(_selectedPrestamo.PrestamoId);

        if (result)
        {
            Snackbar.Add("Préstamo cancelado.", Severity.Info);
            _revisionVisible = false;
            await CargarPrestamos();
        }
        else
        {
            Snackbar.Add("No se pudo cancelar el préstamo.", Severity.Error);
        }
    }

    private static string ObtenerDescripcionEstado(string estado) => estado switch
    {
        "E" => "En Evaluación",
        "A" => "Activo",
        "P" => "Pagado",
        "L" => "Liquidado",
        "C" => "Cancelado",
        "S" => "Suspendido",
        _ => estado
    };

    private static Color ObtenerColorEstadoPrestamo(string estado) => estado switch
    {
        "E" => Color.Warning,
        "A" => Color.Success,
        "P" or "L" => Color.Info,
        "C" => Color.Error,
        "S" => Color.Dark,
        _ => Color.Default
    };
}
