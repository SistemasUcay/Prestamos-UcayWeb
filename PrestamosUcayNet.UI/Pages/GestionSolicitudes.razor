@page "/gestion-solicitudes"
@using Microsoft.AspNetCore.Authorization
@using PrestamosUcayNet.Application.DTOs
@using PrestamosUcayNet.UI.Services
@using PrestamosUcayNet.UI.Components.Dialogs
@using MudBlazor
@attribute [Authorize(Roles = "Administrador,Gerente")]
@inject PrestamosApiService PrestamosApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <div class="d-flex align-center justify-space-between mb-6">
        <MudText Typo="Typo.h4" GutterBottom="true">Gestión de Solicitudes de Préstamo</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("/captura-prestamo"))">
            Nueva Solicitud
        </MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
    else
    {
        <MudDataGrid Items="@_prestamos" Filterable="true" SortMode="SortMode.Multiple" Hover="true" Bordered="true" Striped="true">
            <Columns>
                <PropertyColumn Property="x => x.FechaSolicitud" Title="Fecha" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.NombreEmpleado" Title="Empleado" />
                <PropertyColumn Property="x => x.NombreFondeadora" Title="Fondeadora" />
                <PropertyColumn Property="x => x.TipoPrestamoDescripcion" Title="Tipo Préstamo" />
                <PropertyColumn Property="x => x.MontoAprobado" Title="Monto" Format="C2" />
                <PropertyColumn Property="x => x.PlazoMeses" Title="Plazo (Meses)" />
                <TemplateColumn Title="Estado" CellStyle="width: 130px;">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@ObtenerColorEstadoPrestamo(context.Item.Estado)">
                            @ObtenerDescripcionEstado(context.Item.Estado)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Acciones" CellClass="d-flex justify-end gap-1">
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small" 
                                       Icon="@Icons.Material.Outlined.PictureAsPdf" 
                                       Color="@Color.Default"
                                       OnClick="@(() => VerSolicitudImprimible(context.Item))" 
                                       Title="Ver formato imprimible"
                                       Style="border-radius: 8px;" />
                        <MudIconButton Size="@Size.Small" 
                                       Icon="@Icons.Material.Outlined.Edit" 
                                       Color="@Color.Default"
                                       OnClick="@(() => EditarSolicitud(context.Item))" 
                                       Title="Editar solicitud"
                                       Style="border-radius: 8px;" />
                        <MudIconButton Size="@Size.Small" 
                                       Icon="@Icons.Material.Outlined.RateReview" 
                                       Color="@Color.Primary"
                                       OnClick="@(() => AbrirRevision(context.Item))" 
                                       Title="Revisar solicitud"
                                       Style="border-radius: 8px;" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="PrestamoListDto" />
            </PagerContent>
        </MudDataGrid>
    }
</MudContainer>

@if (_revisionVisible && _selectedPrestamo != null)
{
    <MudOverlay @onclick="@CerrarDialog" Visible="true" DarkBackground="true" ZIndex="9998" />
    <MudPaper Style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999; max-width: 800px; width: 90%; max-height: 90vh; overflow-y: auto;" Elevation="24">
        <MudToolBar>
            <MudText Typo="Typo.h6">Revisión de Préstamo #@_selectedPrestamo.PrestamoId</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="@CerrarDialog" />
        </MudToolBar>

        <MudContainer Style="padding: 24px;">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Empleado</MudText>
                    <MudText Typo="Typo.body1">@_selectedPrestamo.NombreEmpleado</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Fondeadora</MudText>
                    <MudText Typo="Typo.body1">@_selectedPrestamo.NombreFondeadora</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Monto Aprobado</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">@_selectedPrestamo.MontoAprobado.ToString("C2")</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Plazo</MudText>
                    <MudText Typo="Typo.body1">@_selectedPrestamo.PlazoMeses meses</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Tipo de Préstamo</MudText>
                    <MudText Typo="Typo.body1">@_selectedPrestamo.TipoPrestamoDescripcion</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Tipo de Pago</MudText>
                    <MudText Typo="Typo.body1">@_selectedPrestamo.TipoPagoDescripcion</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-4" />
                    <MudTextField T="string" Label="Notas / Motivo (Requerido para rechazo/cancelación)" 
                                  @bind-Value="_notasRevision" Lines="3" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudContainer>

        <MudDivider />

        <MudContainer Style="padding: 16px; display: flex; justify-content: space-between; align-items: center;">
            <MudButton Variant="Variant.Text" OnClick="@CerrarDialog" Disabled="@_procesando">Cerrar</MudButton>
            <div style="display: flex; gap: 8px;">
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@Rechazar"
                           StartIcon="@Icons.Material.Filled.ThumbDown" Disabled="@_procesando">Rechazar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="@Cancelar"
                           StartIcon="@Icons.Material.Filled.Cancel" Disabled="@_procesando">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@AprobarYEntregar"
                           StartIcon="@Icons.Material.Filled.CheckCircle" Disabled="@_procesando">Aprobar y Entregar</MudButton>
            </div>
        </MudContainer>
    </MudPaper>
}

@code {
    private List<PrestamoListDto> _prestamos = new();
    private bool _loading = true;
    private bool _revisionVisible = false;
    private bool _procesando = false;
    private PrestamoListDto? _selectedPrestamo;
    private string _notasRevision = "";
    private DialogOptions _dialogOptions = new() 
    { 
        MaxWidth = MaxWidth.Medium, 
        FullWidth = true,
        CloseButton = true,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarPrestamos();
    }

    private async Task CargarPrestamos()
    {
        _loading = true;
        try
        {
            _prestamos = await PrestamosApi.GetPorEstadoAsync("E");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar préstamos pendientes: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void AbrirRevision(PrestamoListDto item)
    {
        _selectedPrestamo = item;
        _notasRevision = "";
        _revisionVisible = true;
        StateHasChanged();
    }

    private void EditarSolicitud(PrestamoListDto item)
    {
        Navigation.NavigateTo($"/captura-prestamo/{item.PrestamoId}");
    }

    private async Task VerSolicitudImprimible(PrestamoListDto item)
    {
        try
        {
            var parameters = new DialogParameters
            {
                { nameof(SolicitudImprimibleDialog.PrestamoId), item.PrestamoId }
            };

            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true
            };

            await DialogService.ShowAsync<SolicitudImprimibleDialog>(
                $"Solicitud de Préstamo #{item.PrestamoId}",
                parameters,
                options);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al abrir la solicitud: {ex.Message}", Severity.Error);
        }
    }

    private void CerrarDialog()
    {
        _revisionVisible = false;
        _selectedPrestamo = null;
        _notasRevision = "";
        _procesando = false;
        StateHasChanged();
    }

    private async Task AprobarYEntregar()
    {
        if (_selectedPrestamo == null) return;

        _procesando = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(_notasRevision))
            {
                _notasRevision = "Aprobado";
            }

            var result = await PrestamosApi.AprobarAsync(
                _selectedPrestamo.PrestamoId,
                DateTime.Now,
                "Transferencia",
                _notasRevision,
                null,
                _notasRevision);

            if (result)
            {
                Snackbar.Add("Préstamo aprobado y activado exitosamente.", Severity.Success);
                CerrarDialog();
                await CargarPrestamos();
            }
            else
            {
                Snackbar.Add("No se pudo aprobar el préstamo.", Severity.Error);
                _procesando = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al aprobar: {ex.Message}", Severity.Error);
            _procesando = false;
        }
    }

    private async Task Rechazar()
    {
        if (_selectedPrestamo == null) return;
        if (string.IsNullOrWhiteSpace(_notasRevision))
        {
            Snackbar.Add("Debe indicar el motivo del rechazo.", Severity.Warning);
            return;
        }

        _procesando = true;
        StateHasChanged();

        try
        {
            var result = await PrestamosApi.RechazarAsync(_selectedPrestamo.PrestamoId, _notasRevision);

            if (result)
            {
                Snackbar.Add("Préstamo rechazado.", Severity.Info);
                CerrarDialog();
                await CargarPrestamos();
            }
            else
            {
                Snackbar.Add("No se pudo rechazar el préstamo.", Severity.Error);
                _procesando = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al rechazar: {ex.Message}", Severity.Error);
            _procesando = false;
        }
    }

    private async Task Cancelar()
    {
        if (_selectedPrestamo == null) return;
        if (string.IsNullOrWhiteSpace(_notasRevision))
        {
            Snackbar.Add("Debe indicar el motivo de la cancelación.", Severity.Warning);
            return;
        }

        _procesando = true;
        StateHasChanged();

        try
        {
            var result = await PrestamosApi.CancelarSolicitudAsync(_selectedPrestamo.PrestamoId, _notasRevision);

            if (result)
            {
                Snackbar.Add("Solicitud cancelada.", Severity.Info);
                CerrarDialog();
                await CargarPrestamos();
            }
            else
            {
                Snackbar.Add("No se pudo cancelar la solicitud.", Severity.Error);
                _procesando = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cancelar: {ex.Message}", Severity.Error);
            _procesando = false;
        }
    }

    private static string ObtenerDescripcionEstado(string estado) => estado switch
    {
        "E" => "En Evaluación",
        "A" => "Activo",
        "P" => "Pagado",
        "L" => "Liquidado",
        "C" => "Cancelado",
        "R" => "Rechazado",
        "S" => "Suspendido",
        _ => estado
    };

    private static Color ObtenerColorEstadoPrestamo(string estado) => estado switch
    {
        "E" => Color.Warning,
        "A" => Color.Success,
        "P" or "L" => Color.Info,
        "C" => Color.Error,
        "R" => Color.Error,
        "S" => Color.Dark,
        _ => Color.Default
    };
}
