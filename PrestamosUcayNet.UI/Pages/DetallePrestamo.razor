@page "/prestamos/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using PrestamosUcayNet.Application.DTOs
@using PrestamosUcayNet.UI.Services
@using MudBlazor
@attribute [Authorize]
@inject PrestamosApiService PrestamosApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
    else if (_prestamo == null)
    {
        <MudAlert Severity="Severity.Error">Préstamo no encontrado.</MudAlert>
    }
    else
    {
        <MudGrid>
            @* Encabezado y Resumen *@
            <MudItem xs="12">
                <MudPaper Class="pa-6 d-flex align-center justify-space-between flex-wrap">
                    <div>
                        <MudText Typo="Typo.h5" Class="mb-1">
                            Préstamo #@Id
                            @if (!string.IsNullOrEmpty(_prestamo.Folio))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">Folio: @_prestamo.Folio</MudChip>
                            }
                            <MudChip T="string" Size="Size.Small" Color="@ObtenerColorEstado(_prestamo.Estado)">@_prestamo.EstadoDescripcion</MudChip>
                        </MudText>
                        <MudText Typo="Typo.body2">Empleado: <b>@_prestamo.NombreEmpleado</b></MudText>
                        <MudText Typo="Typo.body2">Fondeadora: <b>@_prestamo.NombreFondeadora</b> — Tipo: <b>@_prestamo.TipoPrestamoDescripcion</b> — Pago: <b>@_prestamo.TipoPagoDescripcion</b></MudText>
                    </div>
                    @if (_prestamo.Estado == "A")
                    {
                        <div class="d-flex gap-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCard" OnClick="AbrirPago">Registrar Pago</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.PauseCircle" OnClick="AbrirPausa">Pausar</MudButton>
                        </div>
                    }
                </MudPaper>
            </MudItem>

            @* Tarjetas de Totales *@
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-4 text-center">
                    <MudText Typo="Typo.subtitle2">Monto Aprobado</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary">@_prestamo.MontoAprobado.ToString("C2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-4 text-center">
                    <MudText Typo="Typo.subtitle2">Total a Pagar</MudText>
                    <MudText Typo="Typo.h5">@_prestamo.TotalPagar.ToString("C2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-4 text-center">
                    <MudText Typo="Typo.subtitle2">Saldo Pendiente</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Error">@_prestamo.SaldoPendiente.ToString("C2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-4 text-center">
                    <MudText Typo="Typo.subtitle2">Cuota Mensual</MudText>
                    <MudText Typo="Typo.h5">@_prestamo.ImporteCuotas.ToString("C2")</MudText>
                </MudPaper>
            </MudItem>

            @* Info adicional *@
            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudGrid Spacing="2">
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Tasa Anual</MudText><MudText>@_prestamo.TasaInteresAnual.ToString("N2")%</MudText></MudItem>
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Tasa Mensual</MudText><MudText>@_prestamo.TasaInteresMensual.ToString("N2")%</MudText></MudItem>
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Plazo</MudText><MudText>@_prestamo.PlazoMeses meses (@_prestamo.NumeroCuotas cuotas)</MudText></MudItem>
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Sueldo al Solicitar</MudText><MudText>@_prestamo.SueldoLaboral.ToString("C2")</MudText></MudItem>
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Fecha Solicitud</MudText><MudText>@_prestamo.FechaSolicitud.ToString("dd/MM/yyyy")</MudText></MudItem>
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Fecha Aprobado</MudText><MudText>@_prestamo.FechaAprobado.ToString("dd/MM/yyyy")</MudText></MudItem>
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Inicio Descuento</MudText><MudText>@_prestamo.InicioDescuento.ToString("dd/MM/yyyy")</MudText></MudItem>
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Fin Descuento</MudText><MudText>@_prestamo.FinalDescuento.ToString("dd/MM/yyyy")</MudText></MudItem>
                        <MudItem xs="12" md="6"><MudText Typo="Typo.caption">Destino del Crédito</MudText><MudText>@_prestamo.DestinoCredito</MudText></MudItem>
                        @if (_prestamo.MetodoEntrega is not null)
                        {
                            <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Método Entrega</MudText><MudText>@_prestamo.MetodoEntrega</MudText></MudItem>
                        }
                        @if (_prestamo.ReferenciaBancaria is not null)
                        {
                            <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Referencia</MudText><MudText>@_prestamo.ReferenciaBancaria</MudText></MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudItem>

            @* Tabla de Amortización *@
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Class="mb-4">Tabla de Amortización</MudText>
                <MudTable Items="@_prestamo.TablaAmortizacion" Dense="true" Hover="true" Bordered="true" Striped="true">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>Fecha de Pago</MudTh>
                        <MudTh>P. Programado</MudTh>
                        <MudTh>Capital</MudTh>
                        <MudTh>Interés</MudTh>
                        <MudTh>Saldo Final</MudTh>
                        <MudTh>Estado</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.NumeroPago</MudTd>
                        <MudTd>@context.FechaPago.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd>@context.ImportePago.ToString("C2")</MudTd>
                        <MudTd>@context.ImporteCapital.ToString("C2")</MudTd>
                        <MudTd>@context.ImporteInteres.ToString("C2")</MudTd>
                        <MudTd>@context.SaldoFinal.ToString("C2")</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@(context.Pagado ? Color.Success : Color.Default)">
                                @(context.Pagado ? "Pagado" : "Pendiente")
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@* Diálogo de Pago *@
<MudDialog @bind-Visible="_pagoVisible" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Registrar Pago</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_formPago">
            <MudGrid>
                <MudItem xs="6">
                    <MudNumericField T="decimal" Label="Monto a Pagar" @bind-Value="_montoPago" Required="true" Min="0.01m" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker Label="Fecha" @bind-Date="_fechaPago" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="string" Label="Tipo de Pago" @bind-Value="_tipoPago">
                        <MudSelectItem Value="@("Ordinario")">Pago Ordinario (Nómina)</MudSelectItem>
                        <MudSelectItem Value="@("Extraordinario")">Pago Extraordinario / Adelanto</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (_tipoPago == "Extraordinario")
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info">
                            Los pagos extraordinarios recalculan el saldo inmediatamente.
                        </MudAlert>
                        <MudCheckBox @bind-Value="_reducirPlazo" Label="Reducir plazo (mantener cuota)" Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Class="ml-8">Si se desmarca, se reducirá la cuota mensual manteniendo el plazo.</MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _pagoVisible = false">Cancelar</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmarPago">Registrar</MudButton>
    </DialogActions>
</MudDialog>

@* Diálogo de Pausa *@
<MudDialog @bind-Visible="_pausaVisible" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Solicitar Pausa de Préstamo</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            La pausa desplazará todas las fechas de pago futuras.
        </MudAlert>
        <MudNumericField T="int" Label="Meses de Pausa" @bind-Value="_mesesPausa" Min="1" Max="6" />
        <MudTextField T="string" Label="Motivo" @bind-Value="_motivoPausa" Required="true" Class="mt-4" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _pausaVisible = false">Cerrar</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ConfirmarPausa">Aplicar Pausa</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int Id { get; set; }
    
    private PrestamoDetalleDto? _prestamo;
    private bool _loading = true;
    
    private bool _pagoVisible = false;
    private MudForm _formPago = null!;
    private decimal _montoPago;
    private DateTime? _fechaPago = DateTime.Today;
    private string _tipoPago = "Ordinario";
    private bool _reducirPlazo = true;
    
    private bool _pausaVisible = false;
    private int _mesesPausa = 1;
    private string _motivoPausa = "";

    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnParametersSetAsync()
    {
        await CargarDetalle();
    }

    private async Task CargarDetalle()
    {
        _loading = true;
        try
        {
            _prestamo = await PrestamosApi.GetByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar detalle: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void AbrirPago()
    {
        _montoPago = _prestamo?.TablaAmortizacion.FirstOrDefault(c => !c.Pagado)?.ImportePago ?? 0;
        _pagoVisible = true;
    }

    private async Task ConfirmarPago()
    {
        await _formPago.Validate();
        if (!_formPago.IsValid) return;

        var result = await PrestamosApi.RegistrarPagoAsync(new RegistrarPagoDto
        {
            PrestamoId = Id,
            Monto = _montoPago,
            FechaPago = _fechaPago ?? DateTime.Today,
            TipoPago = _tipoPago,
            ReducirPlazo = _reducirPlazo
        });

        if (result)
        {
            Snackbar.Add("Pago registrado con éxito.", Severity.Success);
            _pagoVisible = false;
            await CargarDetalle();
        }
    }

    private void AbrirPausa() => _pausaVisible = true;

    private async Task ConfirmarPausa()
    {
        if (string.IsNullOrWhiteSpace(_motivoPausa)) return;

        var result = await PrestamosApi.PausarAsync(new SolicitudPausaDto
        {
            PrestamoId = Id,
            MesesPausa = _mesesPausa,
            Motivo = _motivoPausa
        });

        if (result)
        {
            Snackbar.Add("Pausa aplicada. Se han desplazado las fechas de pago.", Severity.Warning);
            _pausaVisible = false;
            await CargarDetalle();
        }
    }

    private static Color ObtenerColorEstado(string estado) => estado switch
    {
        "A" => Color.Success,
        "P" => Color.Info,
        "L" => Color.Tertiary,
        "C" => Color.Error,
        "S" => Color.Warning,
        _ => Color.Default
    };
}
