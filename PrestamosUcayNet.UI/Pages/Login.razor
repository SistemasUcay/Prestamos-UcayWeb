@page "/login"
@layout EmptyLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión — Grupo Yaqui</PageTitle>

<MudThemeProvider Theme="_loginTheme" />

<div class="login-container">
    <div class="login-overlay">
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
            <MudCard Elevation="8" Class="login-card pa-4" Style="width: 100%; max-width: 420px; border-radius: 16px;">
                <MudCardContent>
                    @* Logo y título *@
                    <div class="text-center mb-6">
                        <MudImage Src="images/logo-grupo-yaqui.svg" Alt="Grupo Yaqui" Width="180" Height="180" Class="mx-auto" />
                        <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mt-2">
                            Sistema de Gestión de Préstamos
                        </MudText>
                    </div>

                    <MudDivider Class="mb-4" />

                    @* Formulario de login *@
                    <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
                        <MudTextField @bind-Value="_loginModel.Email"
                            Label="Correo electrónico"
                            Variant="Variant.Outlined"
                            InputType="InputType.Email"
                            Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.Email"
                            Class="mb-4"
                            Required="true"
                            RequiredError="El correo es requerido"
                            Disabled="@_loading" />

                        <MudTextField @bind-Value="_loginModel.Password"
                            Label="Contraseña"
                            Variant="Variant.Outlined"
                            InputType="@_passwordInput"
                            Adornment="Adornment.End"
                            AdornmentIcon="@_passwordIcon"
                            OnAdornmentClick="TogglePasswordVisibility"
                            Class="mb-2"
                            Required="true"
                            RequiredError="La contraseña es requerida"
                            Disabled="@_loading" />

                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <MudAlert Severity="Severity.Error" Class="mt-3 mb-3" Dense="true" Variant="Variant.Filled">
                                @_errorMessage
                            </MudAlert>
                        }

                        <MudButton ButtonType="ButtonType.Submit"
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            FullWidth="true"
                            Size="Size.Large"
                            Class="mt-4"
                            Style="border-radius: 8px; text-transform: none; font-size: 16px;"
                            Disabled="@_loading">
                            @if (_loading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Ingresando...</span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
                                <span>Iniciar Sesión</span>
                            }
                        </MudButton>
                    </EditForm>
                </MudCardContent>

                <MudCardActions Class="justify-center pb-4">
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">
                        © 2026 Grupo Yaqui — Todos los derechos reservados
                    </MudText>
                </MudCardActions>
            </MudCard>
        </MudContainer>
    </div>
</div>

<style>
    .login-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 30%, #E67E22 70%, #C0392B 100%);
        background-size: 400% 400%;
        animation: gradientShift 12s ease infinite;
    }

    .login-overlay {
        min-height: 100vh;
        background: rgba(0, 0, 0, 0.15);
        backdrop-filter: blur(2px);
    }

    .login-card {
        background: rgba(255, 255, 255, 0.97) !important;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3) !important;
    }

    @@keyframes gradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
</style>

@code {
    private LoginModel _loginModel = new();
    private bool _loading = false;
    private string? _errorMessage;
    private bool _showPassword = false;
    private InputType _passwordInput = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private MudTheme _loginTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2E7D32",
            Secondary = "#E67E22"
        }
    };

    void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
        _passwordInput = _showPassword ? InputType.Text : InputType.Password;
        _passwordIcon = _showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    async Task HandleLogin()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        var (success, error) = await AuthService.LoginAsync(_loginModel);

        if (success)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else
        {
            _errorMessage = error ?? "Error al iniciar sesión.";
        }

        _loading = false;
    }
}
