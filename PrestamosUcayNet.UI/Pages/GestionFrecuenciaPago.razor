@page "/gestion-frecuencia-pago"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador,RecursosHumanos")]
@inject CatalogosApiService CatalogosApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Gestión de Frecuencia de Pago — Préstamos UcayNet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">
    <MudIcon Icon="@Icons.Material.Filled.EventRepeat" Class="mr-2" Style="vertical-align: middle;" />
    Gestión de Frecuencia de Pago
</MudText>
<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-4">
    Administra los tipos de pago y su frecuencia
</MudText>

@* Barra de búsqueda y botón Nuevo *@
<MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-radius: 12px;">
    <MudGrid Spacing="2" Justify="Justify.SpaceBetween" Class="align-center">
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_searchString" Placeholder="Buscar por nombre o ID..."
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add"
                OnClick="() => AbrirFormulario()"
                Style="border-radius: 8px; text-transform: none;">
                Nueva Frecuencia
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* Tabla de datos *@
<MudPaper Elevation="2" Class="pa-4" Style="border-radius: 12px;">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    <MudDataGrid T="TipoPagoDto" Items="@_tiposPago" Dense="true"
        Hover="true" Striped="true" Bordered="false"
        QuickFilter="@_quickFilter"
        Style="border-radius: 8px;"
        RowsPerPage="15">
        <Columns>
            <PropertyColumn Property="x => x.TipoPagoId" Title="ID" CellStyle="width: 80px;" />
            <PropertyColumn Property="x => x.Descripcion" Title="Descripción" />
            <PropertyColumn Property="x => x.IntervaloDiario" Title="Días" CellStyle="width: 100px;" />
            <PropertyColumn Property="x => x.IntervaloMensual" Title="Meses" CellStyle="width: 100px;" />
            <PropertyColumn Property="x => x.FrecuenciaAnual" Title="Pagos/Año" CellStyle="width: 120px;" />
            <TemplateColumn Title="Uso" CellStyle="width: 120px;">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small"
                        Color="@(context.Item.CantidadAsociados > 0 ? Color.Info : Color.Default)"
                        Variant="Variant.Outlined">
                        @context.Item.CantidadAsociados
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" CellStyle="width: 120px;">
                <CellTemplate>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small"
                            OnClick="@(() => AbrirFormulario(context.Item))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                            Disabled="@(context.Item.CantidadAsociados > 0)"
                            OnClick="@(() => ConfirmarEliminacion(context.Item))" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-4">
                No se encontraron frecuencias de pago.
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="TipoPagoDto" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>

@* Diálogo de Formulario *@
<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(_model.TipoPagoId == 0 ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)"
                Class="mr-2" Style="vertical-align: middle;" />
            @(_model.TipoPagoId == 0 ? "Nueva Frecuencia de Pago" : "Editar Frecuencia de Pago")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudTextField T="string" Label="Descripción" @bind-Value="_model.Descripcion"
                Required="true" RequiredError="La descripción es obligatoria"
                Counter="50" MaxLength="50"
                Validation="@(new Func<string, string?>(ValidarDescripcion))"
                Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4"
                Immediate="true"
                Disabled="@_saving" />
            <MudGrid Spacing="2" Class="mt-2">
                <MudItem xs="6">
                    <MudNumericField T="int" Label="Intervalo en Días" @bind-Value="_model.IntervaloDiario"
                        Min="0" Max="365"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        Disabled="@_saving" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="int" Label="Intervalo en Meses" @bind-Value="_model.IntervaloMensual"
                        Min="0" Max="12"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        Disabled="@_saving" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="int" Label="Intervalo Anual" @bind-Value="_model.IntervaloAnual"
                        Min="0" Max="10"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        Disabled="@_saving" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="int" Label="Frecuencia Anual (Pagos/Año)" @bind-Value="_model.FrecuenciaAnual"
                        Min="0" Max="365"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        Disabled="@_saving" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogVisible = false" Disabled="@_saving">Cancelar</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync"
            Disabled="@(!_formIsValid || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Guardando...</span>
            }
            else
            {
                <span>Guardar</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<TipoPagoDto> _tiposPago = new();
    private bool _loading = true;
    private bool _saving;
    private string _searchString = "";
    private bool _dialogVisible;
    private bool _formIsValid;
    private MudForm _form = null!;
    private TipoPagoDto _model = new();
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    protected override async Task OnInitializedAsync()
    {
        await CargarTiposPagoAsync();
    }

    private async Task CargarTiposPagoAsync()
    {
        _loading = true;
        try
        {
            _tiposPago = await CatalogosApi.GetTiposPagoAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar frecuencias de pago: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Func<TipoPagoDto, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (x.Descripcion.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if ($"{x.TipoPagoId}".Contains(_searchString)) return true;
        return false;
    };

    private static string? ValidarDescripcion(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return "La descripción es obligatoria.";
        if (valor.Length < 3)
            return "Debe tener al menos 3 caracteres.";
        return null;
    }

    private void AbrirFormulario(TipoPagoDto? item = null)
    {
        _model = item is null
            ? new TipoPagoDto()
            : new TipoPagoDto
            {
                TipoPagoId = item.TipoPagoId,
                Descripcion = item.Descripcion,
                IntervaloDiario = item.IntervaloDiario,
                IntervaloMensual = item.IntervaloMensual,
                IntervaloAnual = item.IntervaloAnual,
                FrecuenciaAnual = item.FrecuenciaAnual
            };
        _dialogVisible = true;
    }

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_formIsValid) return;

        _saving = true;
        try
        {
            bool esNuevo = _model.TipoPagoId == 0;
            bool success = esNuevo
                ? await CatalogosApi.CreateTipoPagoAsync(_model)
                : await CatalogosApi.UpdateTipoPagoAsync(_model);

            if (success)
            {
                Snackbar.Add(esNuevo ? "Frecuencia de pago creada correctamente." : "Frecuencia de pago actualizada correctamente.", Severity.Success);
                _dialogVisible = false;
                await CargarTiposPagoAsync();
            }
            else
            {
                Snackbar.Add("No se pudo guardar. Verifique que el nombre no esté duplicado.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmarEliminacion(TipoPagoDto item)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirmar Eliminación",
            $"¿Está seguro de eliminar la frecuencia de pago '{item.Descripcion}'?",
            yesText: "Eliminar", cancelText: "Cancelar"
        );

        if (result != true) return;

        try
        {
            var success = await CatalogosApi.DeleteTipoPagoAsync(item.TipoPagoId);
            if (success)
            {
                Snackbar.Add("Frecuencia de pago eliminada correctamente.", Severity.Success);
                await CargarTiposPagoAsync();
            }
            else
            {
                Snackbar.Add("No se pudo eliminar. Verifique que no tenga empleados o préstamos asociados.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }
}
